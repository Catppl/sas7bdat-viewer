/*
   Generated by SASDataViewer
   Rule-based Table configuration version 1
   Reference engine: python_rule_based_v1
   Source: analysis.adae
   Treatment: TRT01A
   Count: distinct USUBJID
   Denominator: population
   Total enabled: true
   Percent digits: 1
*/
options validvarname=any;

/* Prepare the independent population denominator. */

data adsl_pop;
    set analysis.ADSL;
    if SAFFL = 'Y';
run;

/* Population N by treatment group */
proc sql noprint;
    select count(distinct USUBJID) into :n1 trimmed from adsl_pop where TRT01A = 'Drug B';
    select count(distinct USUBJID) into :n2 trimmed from adsl_pop where TRT01A = 'Placebo';
    select count(distinct USUBJID) into :n3 trimmed from adsl_pop where TRT01A = 'Drug A';
    select count(distinct USUBJID) into :nt trimmed from adsl_pop where not missing(TRT01A);
quit;

/* Prepare source data */

data adae;
    set analysis.adae;
    if TRTEMFL = 'Y';
run;

/* Calculate denominators. Row filters are deliberately not applied here. */

proc sql;
    create table adae_denom as
    select
        count(distinct (case when TRT01A = 'Drug B' then USUBJID end)) as denom1,
        count(distinct (case when TRT01A = 'Placebo' then USUBJID end)) as denom2,
        count(distinct (case when TRT01A = 'Drug A' then USUBJID end)) as denom3,
        count(distinct (case when not missing(TRT01A) then USUBJID end)) as denom4
    from adsl_pop;
quit;

/* Calculate each configured Rule row independently. */

/* Row 1: Any TEAE */
proc sql;
    create table adae_row1 as
    select
        'Any TEAE' as item length=200,
        count(distinct (case when TRT01A = 'Drug B' then USUBJID end)) as count1,
        count(distinct (case when TRT01A = 'Placebo' then USUBJID end)) as count2,
        count(distinct (case when TRT01A = 'Drug A' then USUBJID end)) as count3,
        count(distinct (case when not missing(TRT01A) then USUBJID end)) as count4
    from adae;
quit;

/* Row 2: Serious TEAE */
proc sql;
    create table adae_row2 as
    select
        '    Serious TEAE' as item length=200,
        count(distinct (case when TRT01A = 'Drug B' then USUBJID end)) as count1,
        count(distinct (case when TRT01A = 'Placebo' then USUBJID end)) as count2,
        count(distinct (case when TRT01A = 'Drug A' then USUBJID end)) as count3,
        count(distinct (case when not missing(TRT01A) then USUBJID end)) as count4
    from adae(where=(AESER = 'Y'));
quit;

/* Combine all row counts before calculating percentages. */
data adae_counts;
    set
        adae_row1
        adae_row2
    ;
run;

/* Calculate n (%) once, after all rows have been combined. */
data work.rule_based_result;
    if _n_ = 1 then set adae_denom;
    set adae_counts;

    /* cnt = numerator counts, den = denominator counts, col = display values. */
    array cnt {*} count1-count4;
    array den {*} denom1-denom4;
    array col {*} $200 col1-col4;

    do i = 1 to dim(cnt);
        if den{i} = 0 then col{i} = '0 (—)';
        else do;
            _pct = cnt{i} / den{i} * 100;
            col{i} = "   " || strip(put(cnt{i}, best.)) || ' (' || strip(put(round(_pct, 0.1), 5.1)) || ')';
        end;
    end;

    label
        item = 'Event'
        col1 = "Drug B (N=&n1) n (%)"
        col2 = "Placebo (N=&n2) n (%)"
        col3 = "Drug A (N=&n3) n (%)"
        col4 = "Total (N=&nt) n (%)"
    ;
    keep item col1-col4;
run;

/* Clean up intermediate WORK tables */
proc datasets library=work nolist;
    delete
        adae
        adsl_pop
        adae_row1
        adae_row2
        adae_counts
        adae_denom
    ;
quit;

