/* 1. Prepare analysis source and centralized labels */
data parm_ord;
    length parm_label $200;
    parm_raw = 'AST'; parm_ord = 1; parm_label = 'AST'; output;
    parm_raw = 'ALT'; parm_ord = 2; parm_label = 'ALT'; output;
run;

data visit_ord;
    length visit_label $200;
    visit_raw = 'Week 4'; visit_ord = 1; visit_label = 'Week 4'; output;
    visit_raw = 'Week 8'; visit_ord = 2; visit_label = 'Week 8'; output;
run;

data trt_ord;
    length trt_label $200;
    trt_raw = 'A'; trt_ord = 1; trt_label = 'Drug A'; output;
    trt_raw = 'B'; trt_ord = 2; trt_label = 'Drug B'; output;
run;

data grade_ord;
    length grade_label $200;
    grade_raw = 0; grade_ord = 1; grade_label = '0'; output;
    grade_raw = 1; grade_ord = 2; grade_label = '1'; output;
    grade_raw = 2; grade_ord = 3; grade_label = '2'; output;
run;

/* 2. Calculate Population N */
proc sql noprint;
    select count(distinct USUBJID) into :n1 trimmed from adam.adsl where SAFFL = 'Y' and TRT01A = 'A';
    select count(distinct USUBJID) into :n2 trimmed from adam.adsl where SAFFL = 'Y' and TRT01A = 'B';
    select count(distinct USUBJID) into :nt trimmed from adam.adsl where SAFFL = 'Y' and TRT01A in ('A', 'B');
quit;
%let n1=&n1;
%let n2=&n2;
%let nt=&nt;

data raw;
    set adam.adlb;
    if SAFFL = 'Y' and ANL01FL = 'Y';
run;

proc sql;
    create table src as
    select a.*, p.parm_ord, p.parm_label, v.visit_ord, v.visit_label,
           t.trt_ord, t.trt_label,
           b.grade_ord as base_ord, b.grade_label as base_label,
           g.grade_ord as post_ord, g.grade_label as post_label
    from raw as a
    inner join parm_ord as p on a.PARAMCD = p.parm_raw
    inner join visit_ord as v on a.AVISIT = v.visit_raw
    inner join trt_ord as t on a.TRTA = t.trt_raw
    inner join grade_ord as b on a.BGRD = b.grade_raw
    inner join grade_ord as g on a.PGRD = g.grade_raw;
quit;

/* 3. Calculate analyzable denominators and observed cells */
proc sql;
    create table parm_visit as
    select distinct PARAMCD, parm_ord, parm_label,
                    AVISIT, visit_ord, visit_label
    from src;

    create table denom as
    select PARAMCD, AVISIT, TRTA,
           count(distinct USUBJID) as denom
    from src
    group by PARAMCD, AVISIT, TRTA;

    create table cell_n as
    select PARAMCD, AVISIT, TRTA,
           BGRD, PGRD,
           count(distinct USUBJID) as subject_n
    from src
    group by PARAMCD, AVISIT, TRTA,
             BGRD, PGRD;

    create table row_n as
    select PARAMCD, AVISIT, TRTA,
           BGRD, count(distinct USUBJID) as subject_n
    from src
    group by PARAMCD, AVISIT, TRTA, BGRD;

    create table col_n as
    select PARAMCD, AVISIT, TRTA,
           PGRD, count(distinct USUBJID) as subject_n
    from src
    group by PARAMCD, AVISIT, TRTA, PGRD;

    create table grand_n as
    select PARAMCD, AVISIT, TRTA,
           count(distinct USUBJID) as subject_n
    from src
    group by PARAMCD, AVISIT, TRTA;
quit;

/* 4. Build the complete treatment-by-grade matrix */
proc sql;
    create table detail as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           b.grade_ord as base_ord, b.grade_label as base_label, b.grade_raw as base_raw,
           g.grade_ord as post_ord, g.grade_label as post_label, g.grade_raw as post_raw,
           'detail' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    cross join grade_ord as b
    cross join grade_ord as g
    left join cell_n as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and t.trt_raw = n.TRTA
     and b.grade_raw = n.BGRD
     and g.grade_raw = n.PGRD
    left join denom as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT
     and t.trt_raw = d.TRTA;

    create table row_total as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           b.grade_ord as base_ord, b.grade_label as base_label, b.grade_raw as base_raw,
           4 as post_ord, 'Total' as post_label length=200,
           . as post_raw, 'row_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    cross join grade_ord as b
    left join row_n as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and t.trt_raw = n.TRTA
     and b.grade_raw = n.BGRD
    left join denom as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT
     and t.trt_raw = d.TRTA;

    create table column_total as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           4 as base_ord, 'Total' as base_label length=200,
           . as base_raw, g.grade_ord as post_ord, g.grade_label as post_label,
           g.grade_raw as post_raw, 'column_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    cross join grade_ord as g
    left join col_n as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and t.trt_raw = n.TRTA
     and g.grade_raw = n.PGRD
    left join denom as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT
     and t.trt_raw = d.TRTA;

    create table grand_total as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           4 as base_ord, 'Total' as base_label length=200,
           . as base_raw, 4 as post_ord,
           'Total' as post_label length=200, . as post_raw,
           'grand_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    left join grand_n as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and t.trt_raw = n.TRTA
    left join denom as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT
     and t.trt_raw = d.TRTA;
quit;

/* 5. Recalculate the optional Overall Total independently */
proc sql;
    create table den_all as
    select PARAMCD, AVISIT,
           count(distinct USUBJID) as denom
    from src group by PARAMCD, AVISIT;

    create table cell_all as
    select PARAMCD, AVISIT,
           BGRD, PGRD,
           count(distinct USUBJID) as subject_n
    from src group by PARAMCD, AVISIT,
                      BGRD, PGRD;

    create table row_all as
    select PARAMCD, AVISIT, BGRD,
           count(distinct USUBJID) as subject_n
    from src group by PARAMCD, AVISIT, BGRD;

    create table col_all as
    select PARAMCD, AVISIT, PGRD,
           count(distinct USUBJID) as subject_n
    from src group by PARAMCD, AVISIT, PGRD;

    create table total_detail as
    select p.*, 3 as trt_ord, 'Total' as trt_label length=200,
           '' as trt_raw, b.grade_ord as base_ord, b.grade_label as base_label,
           b.grade_raw as base_raw, g.grade_ord as post_ord, g.grade_label as post_label,
           g.grade_raw as post_raw, 'detail' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p cross join grade_ord as b cross join grade_ord as g
    left join cell_all as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and b.grade_raw = n.BGRD
     and g.grade_raw = n.PGRD
    left join den_all as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT;

    create table total_row as
    select p.*, 3 as trt_ord, 'Total' as trt_label length=200,
           '' as trt_raw, b.grade_ord as base_ord, b.grade_label as base_label,
           b.grade_raw as base_raw, 4 as post_ord,
           'Total' as post_label length=200, . as post_raw,
           'row_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p cross join grade_ord as b
    left join row_all as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and b.grade_raw = n.BGRD
    left join den_all as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT;

    create table total_column as
    select p.*, 3 as trt_ord, 'Total' as trt_label length=200,
           '' as trt_raw, 4 as base_ord,
           'Total' as base_label length=200, . as base_raw,
           g.grade_ord as post_ord, g.grade_label as post_label, g.grade_raw as post_raw,
           'column_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p cross join grade_ord as g
    left join col_all as n
      on p.PARAMCD = n.PARAMCD
     and p.AVISIT = n.AVISIT
     and g.grade_raw = n.PGRD
    left join den_all as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT;

    create table total_grand as
    select p.*, 3 as trt_ord, 'Total' as trt_label length=200,
           '' as trt_raw, 4 as base_ord,
           'Total' as base_label length=200, . as base_raw,
           4 as post_ord, 'Total' as post_label length=200,
           . as post_raw, 'grand_total' as cell_role length=20,
           coalesce(d.denom, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p left join den_all as d
      on p.PARAMCD = d.PARAMCD
     and p.AVISIT = d.AVISIT;
quit;

/* 6. Apply display formatting once */
data work.shift_table_long;
    length display_value $40 column_name $32;
    set detail row_total column_total grand_total
        total_detail total_row total_column total_grand;
    if denominator_n > 0 then do;
        percent_value = round(100 * subject_n / denominator_n, 0.1);
        display_value = cat(strip(put(subject_n, 8.)), ' (', strip(put(percent_value, 5.1)), ')');
    end;
    else do;
        percent_value = .;
        display_value = '0 (-)';
    end;
    if trt_ord = 3 then do;
        if post_ord = 4 then column_name = 'TOTAL_ALL';
        else column_name = cats('TOTAL_G', post_ord);
    end;
    else do;
        if post_ord = 4 then column_name = cats('T', trt_ord, '_TOTAL');
        else column_name = cats('T', trt_ord, '_G', post_ord);
    end;
run;

proc sort data=work.shift_table_long;
    by parm_ord visit_ord base_ord trt_ord post_ord;
run;

proc transpose data=work.shift_table_long out=_shift_wide(drop=_name_);
