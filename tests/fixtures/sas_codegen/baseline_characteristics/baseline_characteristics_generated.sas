/* Baseline Characteristics generated by SASDataViewer.
   Treatment columns are resolved from the Population Dataset.
   The final shell has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data work.adsl_source;
  length trt_key trt_label $200;
  set analysis.adsl;
  where SAFFL = 'Y';
  if ^missing(TRT01A);
  trt_key=strip(TRT01A);
  trt_label=trt_key;
run;

/* Population N */
proc sql noprint;
  select count(distinct USUBJID) into :n1 trimmed from analysis.ADSL where SAFFL = 'Y' and TRT01A='Placebo';
  select count(distinct USUBJID) into :n2 trimmed from analysis.ADSL where SAFFL = 'Y' and TRT01A='Drug A';
  select count(distinct USUBJID) into :nt trimmed from analysis.ADSL where SAFFL = 'Y' and ^missing(TRT01A);
quit;

/* Treatment order and population counts */
data work.adsl_trt;
  length trt_key trt_label $200 trt_order big_n 8;
  trt_order=1;
  big_n=&n1;
  trt_key=strip('Placebo');
  trt_label=trt_key;
  output;
  trt_order=2;
  big_n=&n2;
  trt_key=strip('Drug A');
  trt_label=trt_key;
  output;
  trt_order=3;
  big_n=&nt;
  trt_key="TOTAL";
  trt_label="Total";
  output;
run;

/* Validate the analysis source subject structure */
proc sql noprint;
  select count(*) into :missing_subject trimmed from work.adsl_source where missing(USUBJID);
  select count(*)-count(distinct USUBJID) into :duplicate_subject trimmed from work.adsl_source;
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing USUBJID.;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per USUBJID.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

/* Long rows are calculated once, then transposed to treatment columns. */
data work.adsl_long;
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200;
  stop;
run;



/* Categorical item: Sex */
data work.adsl_cat_source_1;
  length level_value $400 sort_rank 8;
  set work.adsl_source;
  if missing(SEX) then level_value="Missing";
  else level_value=strip(SEX);
  sort_rank=1000000;
  if SEX='F' then sort_rank=1;
  if SEX='M' then sort_rank=2;
  if SEX='' then sort_rank=3;
run;

proc sql;
  create table work.adsl_cat_freq_1 as
  select trt_key, level_value, count(distinct USUBJID) as numerator
  from work.adsl_cat_source_1
  group by trt_key, level_value;
  insert into work.adsl_cat_freq_1
  select "TOTAL", level_value, count(distinct USUBJID) as numerator
  from work.adsl_cat_source_1
  group by level_value;
  create table work.adsl_cat_levels_1 as
  select level_value, min(sort_rank) as sort_rank
  from work.adsl_cat_source_1
  group by level_value;
quit;

proc sort data=work.adsl_cat_levels_1;
  by sort_rank level_value;
run;

data work.adsl_cat_levels_1;
  set work.adsl_cat_levels_1;
  level_order=_n_;
run;

proc sql;
  create table work.adsl_cat_1 as
  select t.trt_order, t.trt_label, t.big_n,
         l.level_order, l.level_value,
         coalesce(f.numerator,0) as numerator
  from work.adsl_trt as t
  cross join work.adsl_cat_levels_1 as l
  left join work.adsl_cat_freq_1 as f
    on t.trt_key=f.trt_key
   and l.level_value=f.level_value
  order by t.trt_order, l.level_order;
quit;

data work.adsl_item_1;
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200 display_level $400 cnt1 cnt2 $32;
  row_order=1*100000; item_order=1;
  row_label='Sex'; row_value="";
  trt_order=1; trt_label=""; output;
  set work.adsl_cat_1;
  row_order=1*100000+level_order;
  item_order=1;
  display_level=level_value;
  if level_value='F' then display_level='Female';
  if level_value='M' then display_level='Male';
  if level_value="Missing" then display_level='Missing';
  row_label=cats("    ",display_level);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(100*numerator/big_n,0.1),
                         16.1),")");
  output;
run;

proc append base=work.adsl_long data=work.adsl_item_1 force; run;



/* Continuous item: Age (years) */
proc means data=work.adsl_source noprint vardef=df qntldef=5;
  class trt_key;
  var AGE;
  output out=work.adsl_stat_2(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;
proc means data=work.adsl_source noprint vardef=df qntldef=5;
  var AGE;
  output out=work.adsl_stat_total_2(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data work.adsl_stat_total_2;
  length trt_key $200;
  set work.adsl_stat_total_2;
  trt_key="TOTAL";
run;

data work.adsl_stat_all_2;
  set work.adsl_stat_2 work.adsl_stat_total_2;
run;


proc sql;
  create table work.adsl_cont_2 as
  select t.trt_order, t.trt_label, t.big_n,
         s.n, s.mean, s.std, s.median, s.q1, s.q3, s.min, s.max
  from work.adsl_trt as t
  left join work.adsl_stat_all_2 as s
    on t.trt_key=s.trt_key
  order by t.trt_order;
quit;

data work.adsl_item_2;
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200;
  row_order=2*100000; item_order=2;
  row_label='Age (years)'; row_value="";
  trt_order=1; trt_label=""; output;
  set work.adsl_cont_2;
  item_order=2; trt_label=trt_label;
  row_order=2*100000+1; row_label="    n";
  row_value=strip(put(n,3.)); output;
  row_order=2*100000+2; row_label="    Mean";
  row_value=strip(put(round(mean,0.1),8.1));
  if missing(mean) then row_value="-";
  output;
  row_order=2*100000+3; row_label="    SD";
  row_value=strip(put(round(std,0.1),8.1));
  if missing(std) then row_value="-";
  output;
  row_order=2*100000+4; row_label="    Median";
  row_value=strip(put(round(median,0.1),8.1));
  if missing(median) then row_value="-";
  output;
  row_order=2*100000+5; row_label="    Q1, Q3";
  cnt1=strip(put(round(q1,0.1),8.1));
  cnt2=strip(put(round(q3,0.1),8.1));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
  row_order=2*100000+6; row_label="    Min, Max";
  cnt1=strip(put(round(min,1),8.0));
  cnt2=strip(put(round(max,1),8.0));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
  keep row_order item_order row_label row_value trt_order trt_label;
run;

proc append base=work.adsl_long data=work.adsl_item_2 force; run;



/* Continuous item: Body Mass Index (kg/m2) */
proc means data=work.adsl_source noprint vardef=df qntldef=5;
  class trt_key;
  var BMI;
  output out=work.adsl_stat_3(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;
proc means data=work.adsl_source noprint vardef=df qntldef=5;
  var BMI;
  output out=work.adsl_stat_total_3(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data work.adsl_stat_total_3;
  length trt_key $200;
  set work.adsl_stat_total_3;
  trt_key="TOTAL";
run;

data work.adsl_stat_all_3;
  set work.adsl_stat_3 work.adsl_stat_total_3;
run;


proc sql;
  create table work.adsl_cont_3 as
  select t.trt_order, t.trt_label, t.big_n,
         s.n, s.mean, s.std, s.median, s.q1, s.q3, s.min, s.max
  from work.adsl_trt as t
  left join work.adsl_stat_all_3 as s
    on t.trt_key=s.trt_key
  order by t.trt_order;
quit;

data work.adsl_item_3;
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200;
  row_order=3*100000; item_order=3;
  row_label='Body Mass Index (kg/m2)'; row_value="";
  trt_order=1; trt_label=""; output;
  set work.adsl_cont_3;
  item_order=3; trt_label=trt_label;
  row_order=3*100000+1; row_label="    n";
  row_value=strip(put(n,3.)); output;
  row_order=3*100000+2; row_label="    Mean";
  row_value=strip(put(round(mean,0.1),8.1));
  if missing(mean) then row_value="-";
  output;
  row_order=3*100000+3; row_label="    SD";
  row_value=strip(put(round(std,0.1),8.1));
  if missing(std) then row_value="-";
  output;
  row_order=3*100000+4; row_label="    Median";
  row_value=strip(put(round(median,0.1),8.1));
  if missing(median) then row_value="-";
  output;
  keep row_order item_order row_label row_value trt_order trt_label;
run;

proc append base=work.adsl_long data=work.adsl_item_3 force; run;



/* Final wide result */
proc sort data=work.adsl_long;
  by row_order trt_order;
run;

proc sql;
  create table work.adsl_wide as
  select row_order, max(row_label) as row_label length=320
       , max(case when trt_order=1 then row_value else "" end)
           as TRT_1 length=80
       , max(case when trt_order=2 then row_value else "" end)
           as TRT_2 length=80
       , max(case when trt_order=3 then row_value else "" end)
           as TRT_3 length=80
  from work.adsl_long
  group by row_order
  order by row_order;
quit;

data work.baseline_characteristics_test(label='Baseline Characteristics');
  set work.adsl_wide;
  label row_label="Characteristic"
        TRT_1="Placebo (N=&n1)"
        TRT_2="Drug A (N=&n2)"
        TRT_3="Total (N=&nt)"
  ;
  keep row_label TRT_1 TRT_2 TRT_3;
run;

data work.baseline_characteristics_long_test;
  set work.adsl_long;
  value=row_value;
  keep row_order row_label value trt_order trt_label;
run;

proc datasets library=work nolist;
  delete adsl_source adsl_trt:
         adsl_cat: adsl_stat:
         adsl_cont: adsl_item:
         adsl_long adsl_wide;
quit;
