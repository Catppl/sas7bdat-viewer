/* Baseline Characteristics generated by SASDataViewer.
   Treatment columns are resolved from the Population Dataset.
   The final shell has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data adsl_source;
  length trt_key trt_label $200;
  set analysis.adsl;
  where SAFFL = 'Y' and ^missing(TRT01A);
  trt_key=strip(TRT01A);
  trt_label=trt_key;
run;

/* Population N */
proc sql noprint;
  select count(distinct USUBJID) into :n1 trimmed from analysis.ADSL where SAFFL = 'Y' and TRT01A='Placebo';
  select count(distinct USUBJID) into :n2 trimmed from analysis.ADSL where SAFFL = 'Y' and TRT01A='Drug A';
  select count(distinct USUBJID) into :nt trimmed from analysis.ADSL where SAFFL = 'Y' and ^missing(TRT01A);
quit;

/* Treatment order and population counts */
data adsl_trt;
  length trt_key trt_label $200 trt_order big_n 8;
  trt_order=1;
  big_n=&n1;
  trt_key=strip('Placebo');
  trt_label=trt_key;
  output;
  trt_order=2;
  big_n=&n2;
  trt_key=strip('Drug A');
  trt_label=trt_key;
  output;
  trt_order=3;
  big_n=&nt;
  trt_key="TOTAL";
  trt_label="Total";
  output;
run;

/* Validate the analysis source subject structure */
%let duplicate_subject_ids=;
proc sql noprint;
  select count(*) into :missing_subject trimmed from adsl_source where missing(USUBJID);
  select count(*)-count(distinct USUBJID) into :duplicate_subject trimmed from adsl_source;
  select USUBJID into :duplicate_subject_ids separated by ', '
  from adsl_source
  where ^missing(USUBJID)
  group by USUBJID
  having count(*) > 1
  order by USUBJID;
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing USUBJID.;
    data _null_;
      set adsl_source;
      if missing(USUBJID) then
        put "ERROR: Missing USUBJID at source observation " _n_ ".";
    run;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per USUBJID.;
    %put ERROR: Duplicate USUBJID values: &duplicate_subject_ids.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

/* Long rows are calculated once, then transposed to treatment columns. */

%macro baseline_continuous(
    var=,
    order=,
    label=,
    work_prefix=,
    mean_decimals=0,
    std_decimals=0,
    median_decimals=0,
    q1_decimals=0,
    q3_decimals=0,
    min_decimals=0,
    max_decimals=0
);
proc means data=&work_prefix._source noprint nway missing
    vardef=df qntldef=5;
  class trt_key;
  var &var.;
  output out=&work_prefix._stat_&order.
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;
proc means data=&work_prefix._source noprint vardef=df qntldef=5;
  var &var.;
  output out=&work_prefix._stat_total_raw_&order.
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data &work_prefix._stat_total_&order.;
  length trt_key $200;
  set &work_prefix._stat_total_raw_&order.;
  trt_key="TOTAL";
run;

data &work_prefix._stat_all_&order.;
  set &work_prefix._stat_&order. &work_prefix._stat_total_&order.;
run;

proc sql;
  create table &work_prefix._cont_&order. as
  select t.trt_order, t.trt_label, t.big_n
         , s.n, s.mean, s.std, s.median, s.q1, s.q3, s.min, s.max
  from &work_prefix._trt as t
  left join &work_prefix._stat_all_&order. as s
    on t.trt_key=s.trt_key
  order by t.trt_order;
quit;

data &work_prefix._item_&order.;
  length row_order item_order 8 row_label $200 row_value $200
         trt_order 8 trt_label $200 statistic_key $200 cnt1 cnt2 $200;
  set &work_prefix._cont_&order.;
  if _n_=1 then do;
    row_order=&order.*1000;
    item_order=&order.;
    row_label=&label.;
    row_value="";
    statistic_key="";
    trt_order=1;
    trt_label="";
    output;

  end;
  item_order=&order.;
  trt_label=trt_label;
  row_order=&order.*1000+1;
  statistic_key="n";
  row_label="    n";
  row_value=strip(put(n,best.));
  output;

  row_order=&order.*1000+2;
  statistic_key="mean";
  row_label="    Mean";
  row_value=strip(put(mean,8.&mean_decimals.));
  if missing(mean) then row_value="-";
  output;

  row_order=&order.*1000+3;
  statistic_key="std";
  row_label="    SD";
  row_value=strip(put(std,8.&std_decimals.));
  if missing(std) then row_value="-";
  output;

  row_order=&order.*1000+4;
  statistic_key="median";
  row_label="    Median";
  row_value=strip(put(median,8.&median_decimals.));
  if missing(median) then row_value="-";
  output;

  row_order=&order.*1000+5;
  statistic_key="q1_q3";
  row_label="    Q1, Q3";
  cnt1=strip(put(q1,8.&q1_decimals.));
  cnt2=strip(put(q3,8.&q3_decimals.));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2);
  output;

  row_order=&order.*1000+6;
  statistic_key="min_max";
  row_label="    Min, Max";
  cnt1=strip(put(min,8.&min_decimals.));
  cnt2=strip(put(max,8.&max_decimals.));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2);
  output;

  keep row_order item_order row_label row_value trt_order trt_label statistic_key;
run;

%mend baseline_continuous;

/* Categorical item: Sex */
data adsl_cat_source_1;
  length level_value $200 sort_rank 8;
  set adsl_source;
  if missing(SEX) then level_value="Missing";
  else level_value=strip(SEX);
  sort_rank=1000000;
  if SEX='F' then sort_rank=1;
  if SEX='M' then sort_rank=2;
  if SEX='' then sort_rank=3;
run;

proc sql;
  create table adsl_cat_freq_1 as
  select trt_key, level_value, count(distinct USUBJID) as numerator
  from adsl_cat_source_1
  group by trt_key, level_value;
  insert into adsl_cat_freq_1
  select "TOTAL", level_value, count(distinct USUBJID) as numerator
  from adsl_cat_source_1
  group by level_value;
  create table adsl_cat_levels_1 as
  select level_value, min(sort_rank) as sort_rank
  from adsl_cat_source_1
  group by level_value;
quit;

proc sort data=adsl_cat_levels_1;
  by sort_rank level_value;
run;

data adsl_cat_levels_1;
  set adsl_cat_levels_1;
  level_order=_n_;
run;

proc sql;
  create table adsl_cat_1 as
  select t.trt_order, t.trt_label, t.big_n,
         l.level_order, l.level_value,
         coalesce(f.numerator,0) as numerator
  from adsl_trt as t
  cross join adsl_cat_levels_1 as l
  left join adsl_cat_freq_1 as f
    on t.trt_key=f.trt_key
   and l.level_value=f.level_value
  order by t.trt_order, l.level_order;
quit;

data adsl_item_1;
  length row_order item_order 8 row_label $200 row_value $200
         trt_order 8 trt_label $200 display_level $200 cnt1 cnt2 $200;
  set adsl_cat_1;
  if _n_=1 then do;
    row_order=1*1000;
    item_order=1;
    row_label='Sex';
    row_value="";
    trt_order=1;
    trt_label="";
    output;

  end;
  row_order=1*1000+level_order;
  item_order=1;
  display_level=level_value;
  if level_value='F' then display_level='Female';
  if level_value='M' then display_level='Male';
  if level_value="Missing" then display_level='Missing';
  row_label=cats("    ",display_level);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(100*numerator/big_n,0.1),
                         16.1),")");
  output;

run;

/* Continuous item: Age (years) */
%baseline_continuous(
    var=AGE,
    order=2,
    label=%str('Age (years)'),
    work_prefix=adsl,
    mean_decimals=1,
    std_decimals=1,
    median_decimals=1,
    q1_decimals=1,
    q3_decimals=1,
    min_decimals=0,
    max_decimals=0
);

/* Continuous item: Body Mass Index (kg/m2) */
%baseline_continuous(
    var=BMI,
    order=3,
    label=%str('Body Mass Index (kg/m2)'),
    work_prefix=adsl,
    mean_decimals=1,
    std_decimals=1,
    median_decimals=1,
    q1_decimals=0,
    q3_decimals=0,
    min_decimals=0,
    max_decimals=0
);

data adsl_long;
  set
    adsl_item_1
    adsl_item_2
    adsl_item_3
  ;
run;

/* Final wide result */
proc sort data=adsl_long;
  by row_order trt_order;
run;

proc sql;
  create table adsl_wide as
  select row_order, max(row_label) as row_label length=200
       , max(case when trt_order=1 then row_value else "" end)
           as TRT_1 length=200
       , max(case when trt_order=2 then row_value else "" end)
           as TRT_2 length=200
       , max(case when trt_order=3 then row_value else "" end)
           as TRT_3 length=200
  from adsl_long
  group by row_order
  order by row_order;
quit;

data final;
  set adsl_wide;
  label row_label=""
        TRT_1="Placebo (N=&n1)"
        TRT_2="Drug A (N=&n2)"
        TRT_3="Total (N=&nt)"
  ;
  keep row_label TRT_1 TRT_2 TRT_3;
run;

proc datasets library=work nolist;
  delete adsl_source adsl_trt:
         adsl_cat: adsl_stat:
         adsl_cont: adsl_item:
         adsl_long adsl_wide;
quit;
