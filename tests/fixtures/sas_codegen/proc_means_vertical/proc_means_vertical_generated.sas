options validvarname=any;

/* Prepare source */
data adlb;
    set analysis.adlb;
    where SAFFL = 'Y';
run;


/* Prepare population source */
data adsl;
    set analysis.adsl;
    where SAFFL = 'Y';
run;


/* Population N */
proc sql noprint;
    select count(distinct USUBJID) into :n1 trimmed from adsl where TRT01A = 'Placebo';
    select count(distinct USUBJID) into :n2 trimmed from adsl where TRT01A = 'Drug A';
    select count(distinct USUBJID) into :n3 trimmed from adsl where TRT01A = 'Drug B';
    select count(distinct USUBJID) into :nt trimmed from adsl where not missing(TRT01A);
quit;

/* Runtime treatment order and header labels */

proc sql;
    create table trt0 as
    select distinct
        TRT01A
    from adlb;
quit;


data trt;
    set trt0;
    trt_ord = .;
    if TRT01A = 'Placebo' then trt_ord = 1;
    else if TRT01A = 'Drug A' then trt_ord = 2;
    else if TRT01A = 'Drug B' then trt_ord = 3;
    if missing(trt_ord) then delete;
run;





/* One reusable macro per analysis variable.  Variable-specific settings are
   visible at the invocation lines below, so adding another variable does not
   duplicate the PROC MEANS implementation. */
%macro pm_vertical_analysis(
    var=,
    token=,
    label=,
    row_base=,
    mean_decimals=,
    std_decimals=,
    stderr_decimals=,
    median_decimals=,
    q1_decimals=,
    q3_decimals=,
    min_decimals=,
    max_decimals=,
    lclm_decimals=,
    uclm_decimals=
);
/* Statistics for &var. */
proc means data=adlb noprint nway missing
    vardef=df qntldef=5 alpha=0.05;
    class TRT01A;
    var &var.;
    output out=stat_&token.(drop=_type_ _freq_)
        n=n
        mean=mean
        std=std
        median=median
        q1=q1
        q3=q3
        min=min
        max=max
        lclm=lclm
        uclm=uclm
        ;
run;

/* Distinct subject count for &var. */
proc sql;
    create table subj_&token. as
    select
        TRT01A,
        count(distinct USUBJID) as subject_n
    from adlb
    where not missing(&var.)
      and not missing(USUBJID)
    group by TRT01A
;
quit;

/* Align statistics with runtime group order */
proc sql;
    create table out_&token. as
    select g.trt_ord,
           s.*,
           coalesce(u.subject_n, 0) as subject_n
    from trt as g
    left join stat_&token. as s
        on g.TRT01A = s.TRT01A
    left join subj_&token. as u
        on g.TRT01A = u.TRT01A
    order by g.trt_ord;
quit;


/* Total statistics for &var. */
proc means data=adlb noprint
    vardef=df qntldef=5 alpha=0.05;
    var &var.;
    output out=total_&token.(drop=_type_ _freq_)
        n=n
        mean=mean
        std=std
        median=median
        q1=q1
        q3=q3
        min=min
        max=max
        lclm=lclm
        uclm=uclm
        ;
run;

proc sql;
    create table total_&token._n as
    select count(distinct USUBJID) as subject_n
    from adlb
    where not missing(USUBJID);
quit;

data total_&token._row;
    merge total_&token. total_&token._n;
    trt_ord = 4;

run;


