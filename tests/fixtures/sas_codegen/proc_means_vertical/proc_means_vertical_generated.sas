options validvarname=any;

/* Prepare source */
data adlb;
    set analysis.adlb;
    where SAFFL = 'Y';
run;


/* Prepare population source */
data adsl;
    set analysis.adsl;
    where SAFFL = 'Y';
run;


/* Population N */
proc sql noprint;
    select count(distinct USUBJID) into :n1 trimmed from adsl where TRT01A = 'Placebo';
    select count(distinct USUBJID) into :n2 trimmed from adsl where TRT01A = 'Drug A';
    select count(distinct USUBJID) into :n3 trimmed from adsl where TRT01A = 'Drug B';
    select count(distinct USUBJID) into :nt trimmed from adsl where not missing(TRT01A);
quit;

/* Runtime treatment order and header labels */

proc sql;
    create table trt0 as
    select distinct
        TRT01A
    from adlb;
quit;


data trt;
    set trt0;
    trt_ord = .;
    if TRT01A = 'Placebo' then trt_ord = 1;
    else if TRT01A = 'Drug A' then trt_ord = 2;
    else if TRT01A = 'Drug B' then trt_ord = 3;
    if missing(trt_ord) then delete;
run;






/* Statistics for AGE */
proc means data=adlb noprint nway missing
    vardef=df qntldef=5 alpha=0.05;
    class TRT01A;
    var AGE;
    output out=stat_age(drop=_type_ _freq_)
        n=n
        mean=mean
        std=std
        median=median
        q1=q1
        q3=q3
        min=min
        max=max
        lclm=lclm
        uclm=uclm
        ;
run;

/* Distinct subject count for AGE */
proc sql;
    create table subj_age as
    select
        TRT01A,
        count(distinct USUBJID) as subject_n
    from adlb
    where not missing(AGE)
      and not missing(USUBJID)
    group by TRT01A
;
quit;

/* Align statistics with runtime group order */
proc sql;
    create table out_age as
    select g.trt_ord,
           s.*,
           coalesce(u.subject_n, 0) as subject_n
    from trt as g
    left join stat_age as s
        on g.TRT01A = s.TRT01A
    left join subj_age as u
        on g.TRT01A = u.TRT01A
    order by g.trt_ord;
quit;


/* Total statistics for AGE */
proc means data=adlb noprint
    vardef=df qntldef=5 alpha=0.05;
    var AGE;
    output out=total_age(drop=_type_ _freq_)
        n=n
        mean=mean
        std=std
        median=median
        q1=q1
        q3=q3
        min=min
        max=max
        lclm=lclm
        uclm=uclm
        ;
run;

proc sql;
    create table total_age_n as
    select count(distinct USUBJID) as subject_n
    from adlb
    where not missing(USUBJID);
quit;

data total_age_row;
    merge total_age total_age_n;
    trt_ord = 4;

