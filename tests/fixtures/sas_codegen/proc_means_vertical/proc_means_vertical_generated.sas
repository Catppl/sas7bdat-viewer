    select distinct
        TRT01A
    from adlb;
quit;

data trt;
    length trt_label $200;
    length trt1_key trt1_label $200;
    set trt0;
    if missing(TRT01A) then trt1_label = "(Missing)";
    else trt1_label = strip(TRT01A);
    if missing(TRT01A) then trt1_key = "";
    else trt1_key = lowcase(strip(TRT01A));

    trt_label = catx(" / ", trt1_label);
run;

proc sort data=trt;
    by trt1_key;
run;

data trt;
    set trt;
    trt_ord = _n_;
run;


data trt_n;
    set trt;
    if TRT01A = 'Placebo' then big_n = &n1;
    else if TRT01A = 'Drug A' then big_n = &n2;
    else if TRT01A = 'Drug B' then big_n = &n3;
    else big_n = .;
run;

proc sql noprint;
    select coalesce(max(trt_ord), 0) into :n_trt trimmed from trt;
quit;


%let base_age = 0;


/* Statistics for AGE */
proc means data=adlb noprint nway missing
    vardef=df qntldef=5 alpha=0.05;
    class TRT01A;
    var AGE;
    output out=stat_age(drop=_type_ _freq_)
        n=n
        mean=mean
        std=std
        median=median
        q1=q1
        q3=q3
        min=min
        max=max
        lclm=lclm
        uclm=uclm
        ;
run;

/* Distinct subject count for AGE */
proc sql;
    create table subj_age as
    select
        TRT01A,
        count(distinct USUBJID) as subject_n
    from adlb
    where not missing(AGE)
      and not missing(USUBJID)
    group by TRT01A
;
quit;

/* Align statistics with runtime group order */
proc sql;
    create table out_age as
    select g.trt_ord,
           g.trt_label,
           g.big_n,
           s.*,
           coalesce(u.subject_n, 0) as subject_n
    from trt_n as g
    left join stat_age as s
        on g.TRT01A = s.TRT01A
    left join subj_age as u
        on g.TRT01A = u.TRT01A
    order by g.trt_ord;
quit;


