cde_missing <- function(value, type) {
  is.na(value) | (type == "character" & as.character(value) == "")
}

cde_compare <- function(left, right, operator) {
  switch(
    operator,
    "=" = left == right,
    "!=" = left != right,
    "^=" = left != right,
    "~=" = left != right,
    "<>" = left != right,
    ">" = left > right,
    ">=" = left >= right,
    "<" = left < right,
    "<=" = left <= right,
    stop("Unsupported comparison operator: ", operator)
  )
}

cde_prefix_compare <- function(left, right, operator) {
  left_text <- ifelse(is.na(left), "", as.character(left))
  right_text <- ifelse(is.na(right), "", as.character(right))
  length <- pmin(nchar(left_text, type = "chars"), nchar(right_text, type = "chars"))
  cde_compare(
    substr(left_text, 1L, length),
    substr(right_text, 1L, length),
    operator
  )
}

cde_contains <- function(left, right) {
  left_text <- ifelse(is.na(left), "", as.character(left))
  right_text <- ifelse(is.na(right), "", as.character(right))
  mapply(grepl, right_text, left_text, fixed = TRUE, USE.NAMES = FALSE)
}

cde_between <- function(value, lower, upper) {
  value >= lower & value <= upper
}

cde_regex_escape <- function(value) {
  gsub("([][{}()+*^$|\\\\?.])", "\\\\\\\\\\1", value, perl = TRUE)
}

cde_sas_like_regex <- function(pattern, escape = NA_character_) {
  characters <- strsplit(as.character(pattern), "", fixed = TRUE)[[1]]
  pieces <- character()
  escaping <- FALSE
  for (character in characters) {
    if (!is.na(escape) && !escaping && identical(character, escape)) {
      escaping <- TRUE
    } else if (!escaping && identical(character, "%")) {
      pieces <- c(pieces, ".*")
    } else if (!escaping && identical(character, "_")) {
      pieces <- c(pieces, ".")
    } else {
      pieces <- c(pieces, cde_regex_escape(character))
      escaping <- FALSE
    }
  }
  paste0("^", paste0(pieces, collapse = ""), "$")
}

cde_like <- function(value, pattern, escape = NA_character_) {
  regex <- cde_sas_like_regex(pattern, escape)
  grepl(regex, ifelse(is.na(value), "", as.character(value)), perl = TRUE)
}

cde_in <- function(value, choices) {
  value %in% choices
}

cde_normalize_group <- function(value, type) {
  if (is.na(value) || (type == "character" && as.character(value) == "")) {
    return(NA)
  }
  value
}

cde_group_component <- function(value, type) {
  missing <- cde_missing(value, type)
  if (type == "numeric") {
    rendered <- format(as.numeric(value), digits = 17, scientific = FALSE, trim = TRUE)
    rendered[missing] <- ""
    return(ifelse(missing, "M", paste0("N", nchar(rendered, type = "bytes"), ":", rendered)))
  }
  rendered <- enc2utf8(as.character(value))
  rendered[missing] <- ""
  ifelse(missing, "M", paste0("C", nchar(rendered, type = "bytes"), ":", rendered))
}

cde_group_rows <- function(data, variables, types) {
  if (!length(variables)) {
    return(list(seq_len(nrow(data))))
  }
  if (!nrow(data)) {
    return(list())
  }
  components <- lapply(variables, function(name) {
    cde_group_component(data[[name]], types[[name]])
  })
  keys <- do.call(paste, c(components, sep = "\034"))
  grouped <- lapply(unique(keys), function(key) which(keys == key))
  representatives <- vapply(grouped, function(rows) rows[[1]], integer(1))
  sort_arguments <- list()
  for (name in variables) {
    value <- data[[name]][representatives]
    missing <- cde_missing(value, types[[name]])
    sort_arguments <- c(sort_arguments, list(ifelse(missing, 0L, 1L)))
    if (types[[name]] == "numeric") {
      sort_arguments <- c(sort_arguments, list(ifelse(missing, 0, as.numeric(value))))
    } else {
      sort_arguments <- c(sort_arguments, list(ifelse(missing, "", as.character(value))))
    }
  }
  grouped[do.call(order, c(sort_arguments, list(method = "radix")))]
}

cde_fsum <- function(values) {
  total <- 0
  compensation <- 0
  for (value in values) {
    temporary <- total + value
    if (abs(total) >= abs(value)) {
      compensation <- compensation + (total - temporary) + value
    } else {
      compensation <- compensation + (value - temporary) + total
    }
    total <- temporary
  }
  total + compensation
}

cde_qntldef5 <- function(values, probability) {
  if (!length(values)) {
    return(NA_real_)
  }
  ordered <- sort(values)
  position <- length(ordered) * probability
  if (position <= 0) {
    return(ordered[[1]])
  }
  if (position >= length(ordered)) {
    return(ordered[[length(ordered)]])
  }
  integer <- floor(position)
  if (isTRUE(all.equal(position, integer, tolerance = 1e-12))) {
    return((ordered[[integer]] + ordered[[integer + 1L]]) / 2)
  }
  ordered[[integer + 1L]]
}

cde_statistics <- function(values, filtered_rows, subject_values, confidence, requested) {
  values <- values[!is.na(values)]
  count <- length(values)
  result <- list(
    SUBJECT_N = if (is.null(subject_values)) NA_integer_ else as.integer(length(unique(subject_values))),
    N = as.integer(count),
    NMISS = as.integer(filtered_rows - count),
    MEAN = NA_real_, SD = NA_real_, SE = NA_real_, MEDIAN = NA_real_,
    Q1 = NA_real_, Q3 = NA_real_, MIN = NA_real_, MAX = NA_real_,
    LCLM = NA_real_, UCLM = NA_real_
  )
  if ("MEDIAN" %in% requested) result$MEDIAN <- cde_qntldef5(values, 0.5)
  if ("Q1" %in% requested) result$Q1 <- cde_qntldef5(values, 0.25)
  if ("Q3" %in% requested) result$Q3 <- cde_qntldef5(values, 0.75)
  if ("MIN" %in% requested && count) result$MIN <- min(values)
  if ("MAX" %in% requested && count) result$MAX <- max(values)
  needs_mean <- any(c("MEAN", "SD", "SE", "LCLM", "UCLM") %in% requested)
  if (!count || !needs_mean) return(result)
  mean_value <- cde_fsum(values) / count
  if ("MEAN" %in% requested) result$MEAN <- mean_value
  if (count <= 1L) return(result)
  variance <- cde_fsum((values - mean_value)^2) / (count - 1L)
  standard_deviation <- sqrt(variance)
  standard_error <- standard_deviation / sqrt(count)
  if ("SD" %in% requested) result$SD <- standard_deviation
  if ("SE" %in% requested) result$SE <- standard_error
  if (any(c("LCLM", "UCLM") %in% requested)) {
    critical <- qt((1 + confidence) / 2, df = count - 1L)
    if ("LCLM" %in% requested) result$LCLM <- mean_value - critical * standard_error
    if ("UCLM" %in% requested) result$UCLM <- mean_value + critical * standard_error
  }
  result
}

cde_observed_decimals <- function(value) {
  text <- format(value, scientific = FALSE, trim = TRUE, digits = 15)
  if (!grepl("\\.", text)) return(0L)
  fraction <- sub("^.*\\.", "", text)
  fraction <- sub("0+$", "", fraction)
  as.integer(min({{ maximum_decimals }}, nchar(fraction, type = "chars")))
}

cde_base_decimals <- function(values) {
  values <- values[!is.na(values)]
  if (!length(values)) return(0L)
  max(vapply(values, cde_observed_decimals, integer(1)))
}

cde_round_half_up <- function(value, digits) {
  factor <- 10^digits
  sign(value) * floor(abs(value) * factor + 0.5 + 1e-12) / factor
}

cde_display <- function(value, digits) {
  if (is.na(value)) return("")
  formatC(cde_round_half_up(value, digits), format = "f", digits = digits)
}

