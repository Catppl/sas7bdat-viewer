    length statistic row_value $200;
    set pm_display;
    statistic = stat_label;
    keep output_row group item statistic col_ord row_value;
run;

proc sort data=pm_long;
    by output_row group item statistic col_ord;
run;

proc transpose data=pm_long out={{ output_dataset }}(drop=_name_ output_row) prefix=col;
    by output_row group item statistic;
    id col_ord;
    var row_value;
