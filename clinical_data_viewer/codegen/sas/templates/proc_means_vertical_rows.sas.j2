/* Statistics for &var. */
proc means data={{ source.work_member | sas_name }} noprint nway missing
    vardef=df qntldef=5 alpha={{ alpha }};
    class {% for group in row_group_variables %}{{ group.sas_name }} {% endfor %}{% for group in group_variables %}{{ group.sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
    var &var.;
    output out=stat_&token.(drop=_type_ _freq_)
{% if proc_statistics %}{% for key in proc_statistics %}        {{ key }}={{ key }}
{% endfor %}        ;
{% else %}        n=internal_n;
{% endif %}run;

/* Distinct subject count for &var. */
proc sql;
    create table subj_&token. as
