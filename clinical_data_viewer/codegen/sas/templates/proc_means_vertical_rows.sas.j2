{% for group in row_group_variables %}        {{ group.sas_name }},{% endfor %}
{% for group in group_variables %}        {{ group.sas_name }},{% endfor %}
        count(distinct {{ subject | sas_name }}) as subject_n
    from {{ source.work_member | sas_name }}
    where not missing(&var.)
      and not missing({{ subject | sas_name }})
    group by {% for group in row_group_variables %}{{ group.sas_name }}{% if not loop.last or group_variables %}, {% endif %}{% endfor %}{% for group in group_variables %}{{ group.sas_name }}{% if not loop.last %}, {% endif %}{% endfor %};
