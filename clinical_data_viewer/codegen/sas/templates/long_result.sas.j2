{% for item in analysis %}
proc means data=work.{{ work_source }} noprint{% if class_variables %} nway missing{% endif %}
    vardef={{ options.vardef | lower }} qntldef={{ options.qntldef }} alpha={{ options.alpha }};
{% if by_variables %}    by {% for variable in by_variables %}{{ variable | sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
{% endif %}
{% if class_variables %}    class {% for variable in class_variables %}{{ variable | sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
{% endif %}
    var {{ item.name | sas_name }};
    output out=work.{{ item.work_stats }}(drop=_TYPE_ _FREQ_)
{% if proc_statistics %}
{% for statistic in proc_statistics %}        {{ statistic.keyword }}={{ statistic.name }}{% if not loop.last %}
{% endif %}{% endfor %};
{% else %}        n=__CDE_INTERNAL_N;
{% endif %}
run;

{% if include_subject_n and options.subject_id_variable and group_variables %}
proc sort data=work.{{ item.work_stats }};
    by {% for variable in group_variables %}{{ variable | sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
run;
{% endif %}

{% include "subject_count.sas.j2" %}

data work.{{ item.work_long }};
    length ANALYSIS_VARIABLE $32 ANALYSIS_LABEL $1024;
{% if include_subject_n and options.subject_id_variable and group_variables %}
    merge work.{{ item.work_stats }}(in=__stats)
          work.{{ item.work_subjects }};
    by {% for variable in group_variables %}{{ variable | sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
    if __stats;
    if missing(SUBJECT_N) then SUBJECT_N=0;
{% elif include_subject_n and options.subject_id_variable %}
    if _n_=1 then set work.{{ item.work_subjects }};
    set work.{{ item.work_stats }};
    if missing(SUBJECT_N) then SUBJECT_N=0;
{% elif include_subject_n %}
    set work.{{ item.work_stats }};
    SUBJECT_N=.;
{% else %}
    set work.{{ item.work_stats }};
{% endif %}
    ANALYSIS_VARIABLE={{ item.name | sas_string }};
    ANALYSIS_LABEL={{ item.label | sas_string }};
{% if needs_internal_n %}    drop __CDE_INTERNAL_N;
{% endif %}
run;

{% endfor %}
data {{ sas_output_dataset }};
    set {% for item in analysis %}work.{{ item.work_long }}{% if not loop.last %} {% endif %}{% endfor %};
run;
