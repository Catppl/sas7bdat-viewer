/* 1. Prepare analysis source and centralized labels */
data parm_ord;
    length parm_label $200;
{% for level in parameters %}    parm_raw = {{ level.literal }}; parm_ord = {{ level.order }}; parm_label = {{ level.label|sas_string }}; output;
{% endfor %}run;

data visit_ord;
    length visit_label $200;
{% for level in visits %}    visit_raw = {{ level.literal }}; visit_ord = {{ level.order }}; visit_label = {{ level.label|sas_string }}; output;
{% endfor %}run;

data trt_ord;
    length trt_label $200;
{% for level in treatments %}    trt_raw = {{ level.literal }}; trt_ord = {{ level.order }}; trt_label = {{ level.label|sas_string }}; output;
{% endfor %}run;

data grade_ord;
    length grade_label $200;
{% for level in grades %}    grade_raw = {{ level.literal }}; grade_ord = {{ level.order }}; grade_label = {{ level.label|sas_string }}; output;
{% endfor %}run;

/* 2. Calculate Population N */
proc sql noprint;
{% for level in treatments %}    select count(distinct {{ population_subject }}) into :n{{ loop.index }} trimmed from {{ population_reference }} where {% if population_where %}{{ population_where }} and {% endif %}{{ population_treatment }} = {{ level.literal }};
{% endfor %}{% if include_total %}    select count(distinct {{ population_subject }}) into :nt trimmed from {{ population_reference }} where {% if population_where %}{{ population_where }} and {% endif %}{{ population_treatment }} in ({% for level in treatments %}{{ level.literal }}{% if not loop.last %}, {% endif %}{% endfor %});
{% endif %}quit;
{% for level in treatments %}%let n{{ loop.index }}=&n{{ loop.index }};
{% endfor %}{% if include_total %}%let nt=&nt;
{% endif %}

data raw;
    set {{ source_reference }};
    if {% if where_expression %}{{ where_expression }} and {% endif %}{{ variables.analysis_flag }} = {{ flag_literal }};
run;

proc sql;
    create table src as
    select a.*, p.parm_ord, p.parm_label, v.visit_ord, v.visit_label,
           t.trt_ord, t.trt_label,
           b.grade_ord as base_ord, b.grade_label as base_label,
           g.grade_ord as post_ord, g.grade_label as post_label
    from raw as a
    inner join parm_ord as p on a.{{ variables.parameter }} = p.parm_raw
    inner join visit_ord as v on a.{{ variables.visit }} = v.visit_raw
    inner join trt_ord as t on a.{{ variables.treatment }} = t.trt_raw
    inner join grade_ord as b on a.{{ variables.baseline_grade }} = b.grade_raw
    inner join grade_ord as g on a.{{ variables.post_grade }} = g.grade_raw;
quit;

/* 3. Calculate analyzable denominators and observed cells */
proc sql;
    create table parm_visit as
    select distinct {{ variables.parameter }}, parm_ord, parm_label,
                    {{ variables.visit }}, visit_ord, visit_label
    from src;

    create table denom as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }},
           count(distinct {{ variables.subject }}) as denom
    from src
    group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }};

    create table cell_n as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }},
           {{ variables.baseline_grade }}, {{ variables.post_grade }},
           count(distinct {{ variables.subject }}) as subject_n
    from src
    group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }},
             {{ variables.baseline_grade }}, {{ variables.post_grade }};

    create table row_n as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }},
           {{ variables.baseline_grade }}, count(distinct {{ variables.subject }}) as subject_n
    from src
    group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }}, {{ variables.baseline_grade }};

    create table col_n as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }},
           {{ variables.post_grade }}, count(distinct {{ variables.subject }}) as subject_n
    from src
    group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }}, {{ variables.post_grade }};

    create table grand_n as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }},
           count(distinct {{ variables.subject }}) as subject_n
    from src
    group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.treatment }};
quit;

/* 4. Build the complete treatment-by-grade matrix */
proc sql;
    create table detail as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           b.grade_ord as base_ord, b.grade_label as base_label, b.grade_raw as base_raw,
           g.grade_ord as post_ord, g.grade_label as post_label, g.grade_raw as post_raw,
           'detail' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    cross join grade_ord as b
    cross join grade_ord as g
    left join cell_n as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and t.trt_raw = n.{{ variables.treatment }}
     and b.grade_raw = n.{{ variables.baseline_grade }}
     and g.grade_raw = n.{{ variables.post_grade }}
    left join denom as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }}
     and t.trt_raw = d.{{ variables.treatment }};

    create table row_total as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           b.grade_ord as base_ord, b.grade_label as base_label, b.grade_raw as base_raw,
           {{ total_grade_order }} as post_ord, 'Total' as post_label length=200,
           {{ grade_missing }} as post_raw, 'row_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    cross join grade_ord as b
    left join row_n as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and t.trt_raw = n.{{ variables.treatment }}
     and b.grade_raw = n.{{ variables.baseline_grade }}
    left join denom as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }}
     and t.trt_raw = d.{{ variables.treatment }};

    create table column_total as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           {{ total_grade_order }} as base_ord, 'Total' as base_label length=200,
           {{ grade_missing }} as base_raw, g.grade_ord as post_ord, g.grade_label as post_label,
           g.grade_raw as post_raw, 'column_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    cross join grade_ord as g
    left join col_n as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and t.trt_raw = n.{{ variables.treatment }}
     and g.grade_raw = n.{{ variables.post_grade }}
    left join denom as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }}
     and t.trt_raw = d.{{ variables.treatment }};

    create table grand_total as
    select p.*, t.trt_ord, t.trt_label, t.trt_raw,
           {{ total_grade_order }} as base_ord, 'Total' as base_label length=200,
           {{ grade_missing }} as base_raw, {{ total_grade_order }} as post_ord,
           'Total' as post_label length=200, {{ grade_missing }} as post_raw,
           'grand_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n,
           coalesce(d.denom, 0) as denominator_n
    from parm_visit as p
    cross join trt_ord as t
    left join grand_n as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and t.trt_raw = n.{{ variables.treatment }}
    left join denom as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }}
     and t.trt_raw = d.{{ variables.treatment }};
quit;

{% if include_total %}
/* 5. Recalculate the optional Overall Total independently */
proc sql;
    create table den_all as
    select {{ variables.parameter }}, {{ variables.visit }},
           count(distinct {{ variables.subject }}) as denom
    from src group by {{ variables.parameter }}, {{ variables.visit }};

    create table cell_all as
    select {{ variables.parameter }}, {{ variables.visit }},
           {{ variables.baseline_grade }}, {{ variables.post_grade }},
           count(distinct {{ variables.subject }}) as subject_n
    from src group by {{ variables.parameter }}, {{ variables.visit }},
                      {{ variables.baseline_grade }}, {{ variables.post_grade }};

    create table row_all as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.baseline_grade }},
           count(distinct {{ variables.subject }}) as subject_n
    from src group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.baseline_grade }};

    create table col_all as
    select {{ variables.parameter }}, {{ variables.visit }}, {{ variables.post_grade }},
           count(distinct {{ variables.subject }}) as subject_n
    from src group by {{ variables.parameter }}, {{ variables.visit }}, {{ variables.post_grade }};

    create table total_detail as
    select p.*, {{ total_treatment_order }} as trt_ord, 'Total' as trt_label length=200,
           {{ treatment_missing }} as trt_raw, b.grade_ord as base_ord, b.grade_label as base_label,
           b.grade_raw as base_raw, g.grade_ord as post_ord, g.grade_label as post_label,
           g.grade_raw as post_raw, 'detail' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p cross join grade_ord as b cross join grade_ord as g
    left join cell_all as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and b.grade_raw = n.{{ variables.baseline_grade }}
     and g.grade_raw = n.{{ variables.post_grade }}
    left join den_all as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }};

    create table total_row as
    select p.*, {{ total_treatment_order }} as trt_ord, 'Total' as trt_label length=200,
           {{ treatment_missing }} as trt_raw, b.grade_ord as base_ord, b.grade_label as base_label,
           b.grade_raw as base_raw, {{ total_grade_order }} as post_ord,
           'Total' as post_label length=200, {{ grade_missing }} as post_raw,
           'row_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p cross join grade_ord as b
    left join row_all as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and b.grade_raw = n.{{ variables.baseline_grade }}
    left join den_all as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }};

    create table total_column as
    select p.*, {{ total_treatment_order }} as trt_ord, 'Total' as trt_label length=200,
           {{ treatment_missing }} as trt_raw, {{ total_grade_order }} as base_ord,
           'Total' as base_label length=200, {{ grade_missing }} as base_raw,
           g.grade_ord as post_ord, g.grade_label as post_label, g.grade_raw as post_raw,
           'column_total' as cell_role length=20,
           coalesce(n.subject_n, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p cross join grade_ord as g
    left join col_all as n
      on p.{{ variables.parameter }} = n.{{ variables.parameter }}
     and p.{{ variables.visit }} = n.{{ variables.visit }}
     and g.grade_raw = n.{{ variables.post_grade }}
    left join den_all as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }};

    create table total_grand as
    select p.*, {{ total_treatment_order }} as trt_ord, 'Total' as trt_label length=200,
           {{ treatment_missing }} as trt_raw, {{ total_grade_order }} as base_ord,
           'Total' as base_label length=200, {{ grade_missing }} as base_raw,
           {{ total_grade_order }} as post_ord, 'Total' as post_label length=200,
           {{ grade_missing }} as post_raw, 'grand_total' as cell_role length=20,
           coalesce(d.denom, 0) as subject_n, coalesce(d.denom, 0) as denominator_n
    from parm_visit as p left join den_all as d
      on p.{{ variables.parameter }} = d.{{ variables.parameter }}
     and p.{{ variables.visit }} = d.{{ variables.visit }};
quit;
{% endif %}

/* 6. Apply display formatting once */
data {{ long_reference }};
    length display_value $40 column_name $32;
    set detail row_total column_total grand_total{% if include_total %}
        total_detail total_row total_column total_grand{% endif %};
    if denominator_n > 0 then do;
        percent_value = round(100 * subject_n / denominator_n, {{ round_unit }});
        display_value = cat(strip(put(subject_n, 8.)), ' (', strip(put(percent_value, {{ percent_format }})), ')');
    end;
    else do;
        percent_value = .;
        display_value = '0 (-)';
    end;
    if trt_ord = {{ total_treatment_order }} then do;
        if post_ord = {{ total_grade_order }} then column_name = 'TOTAL_ALL';
        else column_name = cats('TOTAL_G', post_ord);
    end;
    else do;
        if post_ord = {{ total_grade_order }} then column_name = cats('T', trt_ord, '_TOTAL');
        else column_name = cats('T', trt_ord, '_G', post_ord);
    end;
run;

proc sort data={{ long_reference }};
    by parm_ord visit_ord base_ord trt_ord post_ord;
run;

proc transpose data={{ long_reference }} out=_shift_wide(drop=_name_);
    by parm_ord parm_label visit_ord visit_label base_ord base_label;
    id column_name;
    var display_value;
run;

/* 7. Create the final review dataset */
data {{ output_reference }};
    set _shift_wide;
    length parameter visit baseline_grade $200;
    parameter = parm_label;
    visit = visit_label;
    baseline_grade = base_label;
    keep parameter visit baseline_grade
{% for treatment in treatments %}
{% set treatment_index = loop.index %}
{% for grade in grades %}         T{{ treatment_index }}_G{{ loop.index }}
{% endfor %}         T{{ treatment_index }}_TOTAL
{% endfor %}
{% if include_total %}
{% for grade in grades %}         TOTAL_G{{ loop.index }}
{% endfor %}         TOTAL_ALL
{% endif %}    ;
    label parameter = 'Parameter'
          visit = 'Visit'
          baseline_grade = 'Baseline Grade'
{% for treatment in treatments %}
{% set treatment_index = loop.index %}
{% for grade in grades %}          T{{ treatment_index }}_G{{ loop.index }} = "{{ treatment.label }} (N=&n{{ treatment_index }}) {{ grade.label }}"
{% endfor %}          T{{ treatment_index }}_TOTAL = "{{ treatment.label }} (N=&n{{ treatment_index }}) Total"
{% endfor %}
{% if include_total %}
{% for grade in grades %}          TOTAL_G{{ loop.index }} = "Total (N=&nt) {{ grade.label }}"
{% endfor %}          TOTAL_ALL = "Total (N=&nt) Total"
{% endif %}    ;
run;

/* 8. Remove intermediate datasets only */
proc datasets lib=work nolist;
    delete parm_ord visit_ord trt_ord grade_ord raw src parm_visit denom cell_n
           row_n col_n grand_n detail row_total column_total grand_total
{% if include_total %}           den_all cell_all row_all col_all total_detail total_row total_column total_grand
{% endif %}           _shift_wide;
quit;
