/* Baseline Characteristics generated by SASDataViewer.
   Treatment columns are resolved from the Population Dataset.
   The final shell has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data work.{{ source.work_prefix }}_source;
  length trt_key trt_label $200;
  set {{ source.library }}.{{ source.member }};
{% if where_expression %}  where {{ where_expression }};
{% endif %}{% if treatment.source_kind == "numeric" %}  if ^missing({{ treatment.source }});
  trt_key=strip(put({{ treatment.source }},best32.));
{% else %}  if ^missing({{ treatment.source }});
  trt_key=strip({{ treatment.source }});
{% endif %}  trt_label=trt_key;
run;

/* Population N */
proc sql noprint;
{% for count in population_counts %}  select count(distinct {{ subject }}) into :{{ count.macro }} trimmed from {{ population.library }}.{{ population.member }}{% if population_where_expression %} where {{ population_where_expression }} and {{ treatment.population }}={{ count.population_literal }};{% else %} where {{ treatment.population }}={{ count.population_literal }};{% endif %}
{% endfor %}  select count(distinct {{ subject }}) into :{{ total_n_macro }} trimmed from {{ population.library }}.{{ population.member }}{% if population_where_expression %} where {{ population_where_expression }} and ^missing({{ treatment.population }});{% else %} where ^missing({{ treatment.population }});{% endif %}
quit;

/* Treatment order and population counts */
data work.{{ source.work_prefix }}_trt;
  length trt_key trt_label $200 trt_order big_n 8;
{% for count in population_counts %}  trt_order={{ loop.index }};
  big_n=&{{ count.macro }};
{% if treatment.source_kind == "numeric" %}  trt_key=strip(put({{ count.source_literal }},best32.));
{% else %}  trt_key=strip({{ count.source_literal }});
{% endif %}  trt_label=trt_key;
  output;
{% endfor %}{% if include_total %}  trt_order={{ population_counts|length + 1 }};
  big_n=&{{ total_n_macro }};
  trt_key="TOTAL";
  trt_label="Total";
  output;
{% endif %}run;

/* Validate the analysis source subject structure */
proc sql noprint;
  select count(*) into :missing_subject trimmed from work.{{ source.work_prefix }}_source where missing({{ subject }});
  select count(*)-count(distinct {{ subject }}) into :duplicate_subject trimmed from work.{{ source.work_prefix }}_source;
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

/* Long rows are calculated once, then transposed to treatment columns. */
data work.{{ source.work_prefix }}_long;
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200;
  stop;
run;

{% for item in items %}
{% if item.role == "categorical" %}
/* Categorical item: {{ item.label }} */
data work.{{ source.work_prefix }}_cat_source_{{ item.order }};
  length level_value $400 sort_rank 8;
  set work.{{ source.work_prefix }}_source;
{% if not item.include_missing %}  if ^missing({{ item.variable }});
{% if item.storage_type == "numeric" %}  level_value=strip(put({{ item.variable }},best32.));
{% else %}  level_value=strip({{ item.variable }});
{% endif %}{% else %}{% if item.storage_type == "numeric" %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip(put({{ item.variable }},best32.));
{% else %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip({{ item.variable }});
{% endif %}{% endif %}{% if item.level_order == "custom" %}  sort_rank=1000000;
{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }};
{% endfor %}{% else %}  sort_rank=0;
{% endif %}run;

proc sql;
  create table work.{{ source.work_prefix }}_cat_freq_{{ item.order }} as
  select trt_key, level_value, count(distinct {{ subject }}) as numerator
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by trt_key, level_value;
{% if include_total %}  insert into work.{{ source.work_prefix }}_cat_freq_{{ item.order }}
  select "TOTAL", level_value, count(distinct {{ subject }}) as numerator
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by level_value;
{% endif %}  create table work.{{ source.work_prefix }}_cat_levels_{{ item.order }} as
  select level_value, min(sort_rank) as sort_rank
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by level_value;
quit;

proc sort data=work.{{ source.work_prefix }}_cat_levels_{{ item.order }};
  by sort_rank level_value;
run;

data work.{{ source.work_prefix }}_cat_levels_{{ item.order }};
  set work.{{ source.work_prefix }}_cat_levels_{{ item.order }};
  level_order=_n_;
run;

proc sql;
  create table work.{{ source.work_prefix }}_cat_{{ item.order }} as
  select t.trt_order, t.trt_label, t.big_n,
         l.level_order, l.level_value,
         coalesce(f.numerator,0) as numerator
  from work.{{ source.work_prefix }}_trt as t
  cross join work.{{ source.work_prefix }}_cat_levels_{{ item.order }} as l
  left join work.{{ source.work_prefix }}_cat_freq_{{ item.order }} as f
    on t.trt_key=f.trt_key
   and l.level_value=f.level_value
  order by t.trt_order, l.level_order;
quit;

data work.{{ source.work_prefix }}_item_{{ item.order }};
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200 cnt1 cnt2 $32;
  row_order={{ item.order }}*100000; item_order={{ item.order }};
  row_label={{ item.label | sas_string }}; row_value="";
  trt_order=1; trt_label=""; output;
  set work.{{ source.work_prefix }}_cat_{{ item.order }};
  row_order={{ item.order }}*100000+level_order;
  item_order={{ item.order }};
  row_label=cats("    ",level_value);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(100*numerator/big_n,{{ item.percent_digits | sas_round_increment }}),
                         16.{{ item.percent_digits }}),")");
  output;
run;

proc append base=work.{{ source.work_prefix }}_long data=work.{{ source.work_prefix }}_item_{{ item.order }} force; run;
{% else %}
/* Continuous item: {{ item.label }} */
proc means data=work.{{ source.work_prefix }}_source noprint vardef=df qntldef=5;
  class trt_key;
  var {{ item.variable }};
  output out=work.{{ source.work_prefix }}_stat_{{ item.order }}(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;
{% if include_total %}proc means data=work.{{ source.work_prefix }}_source noprint vardef=df qntldef=5;
  var {{ item.variable }};
  output out=work.{{ source.work_prefix }}_stat_total_{{ item.order }}(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data work.{{ source.work_prefix }}_stat_total_{{ item.order }};
  length trt_key $200;
  set work.{{ source.work_prefix }}_stat_total_{{ item.order }};
  trt_key="TOTAL";
run;

data work.{{ source.work_prefix }}_stat_all_{{ item.order }};
  set work.{{ source.work_prefix }}_stat_{{ item.order }} work.{{ source.work_prefix }}_stat_total_{{ item.order }};
run;
{% endif %}

proc sql;
  create table work.{{ source.work_prefix }}_cont_{{ item.order }} as
  select t.trt_order, t.trt_label, t.big_n,
         s.n, s.mean, s.std, s.median, s.q1, s.q3, s.min, s.max
  from work.{{ source.work_prefix }}_trt as t
  left join work.{{ source.work_prefix }}_stat_{% if include_total %}all_{% endif %}{{ item.order }} as s
    on t.trt_key=s.trt_key
  order by t.trt_order;
quit;

data work.{{ source.work_prefix }}_item_{{ item.order }};
  length row_order item_order 8 row_label $320 row_value $80
         trt_order 8 trt_label $200;
  row_order={{ item.order }}*100000; item_order={{ item.order }};
  row_label={{ item.label | sas_string }}; row_value="";
  trt_order=1; trt_label=""; output;
  set work.{{ source.work_prefix }}_cont_{{ item.order }};
  item_order={{ item.order }}; trt_label=trt_label;
{% if "n" in item.statistics %}  row_order={{ item.order }}*100000+1; row_label="    n";
  row_value=strip(put(n,3.)); output;
{% endif %}{% for key, label in (("mean", "Mean"), ("std", "SD"), ("median", "Median")) %}{% if key in item.statistics %}  row_order={{ item.order }}*100000+{{ loop.index + 1 }}; row_label="    {{ label }}";
  row_value=strip(put(round({{ key }},{{ item.statistic_decimals[key] | sas_round_increment }}),8.{{ item.statistic_decimals[key] }}));
  if missing({{ key }}) then row_value="-";
  output;
{% endif %}{% endfor %}{% if "q1" in item.statistics %}  row_order={{ item.order }}*100000+5; row_label="    Q1, Q3";
  cnt1=strip(put(round(q1,{{ item.statistic_decimals.q1 | sas_round_increment }}),8.{{ item.statistic_decimals.q1 }}));
  cnt2=strip(put(round(q3,{{ item.statistic_decimals.q3 | sas_round_increment }}),8.{{ item.statistic_decimals.q3 }}));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
{% endif %}{% if "min" in item.statistics %}  row_order={{ item.order }}*100000+6; row_label="    Min, Max";
  cnt1=strip(put(round(min,{{ item.statistic_decimals.min | sas_round_increment }}),8.{{ item.statistic_decimals.min }}));
  cnt2=strip(put(round(max,{{ item.statistic_decimals.max | sas_round_increment }}),8.{{ item.statistic_decimals.max }}));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
{% endif %}  keep row_order item_order row_label row_value trt_order trt_label;
run;

proc append base=work.{{ source.work_prefix }}_long data=work.{{ source.work_prefix }}_item_{{ item.order }} force; run;
{% endif %}
{% endfor %}

/* Final wide result */
proc sort data=work.{{ source.work_prefix }}_long;
  by row_order trt_order;
run;

proc sql;
  create table work.{{ source.work_prefix }}_wide as
  select row_order, max(row_label) as row_label length=320
{% for label in treatment_labels %}       , max(case when trt_order={{ loop.index }} then row_value else "" end)
           as {{ label.column }} length=80
{% endfor %}  from work.{{ source.work_prefix }}_long
  group by row_order
  order by row_order;
quit;

data {{ output }}(label={{ header_label | sas_string }});
  set work.{{ source.work_prefix }}_wide;
  label row_label="Characteristic"
{% for label in treatment_labels %}        {{ label.column }}={{ label.text | sas_double_string }}
{% endfor %}  ;
  keep row_label{% for label in treatment_labels %} {{ label.column }}{% endfor %};
run;

data {{ long_output }};
  set work.{{ source.work_prefix }}_long;
  value=row_value;
  keep row_order row_label value trt_order trt_label;
run;

proc datasets library=work nolist;
  delete {{ source.work_prefix }}_source {{ source.work_prefix }}_trt:
         {{ source.work_prefix }}_cat: {{ source.work_prefix }}_stat:
         {{ source.work_prefix }}_cont: {{ source.work_prefix }}_item:
         {{ source.work_prefix }}_long {{ source.work_prefix }}_wide;
quit;
