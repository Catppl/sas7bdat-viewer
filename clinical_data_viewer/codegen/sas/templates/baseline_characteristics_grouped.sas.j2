/* Baseline Characteristics generated by SASDataViewer.
   Treatment columns are resolved from the Population Dataset at run time.
   The final shell has no footnote. */
options validvarname=any;

{% if source.format == "sas7bdat" %}libname {{ source.library }} {{ source.source_directory | sas_string }};
{% else %}libname {{ source.library }} xport {{ source.source_path | sas_string }} access=readonly;
{% endif %}

/* Prepare analysis source */
data work._bc_source;
  set {{ source.library }}.{{ source.member }};
{% if where_expression %}  where {{ where_expression }};
{% endif %}  length _bc_trt_key _bc_trt_label $200;
{% if treatment.source_kind == "numeric" %}  if missing({{ treatment.source }}) then delete;
  _bc_trt_key=strip(put({{ treatment.source }},best32.));
{% else %}  if missing({{ treatment.source }}) then delete;
  _bc_trt_key=strip({{ treatment.source }});
{% endif %}  _bc_trt_label=_bc_trt_key;
run;

/* Population N follows the same N1, N2, ... / NT pattern as vertical PROC MEANS */
proc sql noprint;
{% for count in population_counts %}  select count(distinct {{ subject }}) into :{{ count.macro }} trimmed
  from {{ population.library }}.{{ population.member }}{% if population_where_expression %} where ({{ population_where_expression }}) and {{ treatment.population }} = {{ count.population_literal }};{% else %} where {{ treatment.population }} = {{ count.population_literal }};{% endif %}
{% endfor %}  select count(distinct {{ subject }}) into :{{ total_n_macro }} trimmed
  from {{ population.library }}.{{ population.member }}{% if population_where_expression %} where ({{ population_where_expression }}) and not missing({{ treatment.population }});{% else %} where not missing({{ treatment.population }});{% endif %}
quit;

/* Keep the treatment order resolved from the current Population Dataset */
data work._bc_trt;
  length _bc_trt_key _bc_trt_label $200 trt_order big_n 8;
{% for count in population_counts %}  trt_order={{ loop.index }};
  big_n=&{{ count.macro }};
{% if treatment.source_kind == "numeric" %}  _bc_trt_key=strip(put({{ count.source_literal }},best32.));
{% else %}  _bc_trt_key=strip({{ count.source_literal }});
{% endif %}  
  _bc_trt_label=_bc_trt_key;
  output;
{% endfor %}run;

%let _bc_ntrt={{ population_counts|length }};

data _null_;
  set work._bc_trt;
  call symputx(cats('_bc_label_',trt_order),
               cats(_bc_trt_label,' (N=',put(big_n,comma.),')'));
run;

/* Validate the analysis source subject structure */
proc sql noprint;
  select count(*) into :_bc_missing_subject trimmed
  from work._bc_source where missing({{ subject }});
  select count(*) - count(distinct {{ subject }})
    into :_bc_duplicate_subject trimmed
  from work._bc_source;
quit;

%macro _bc_validate;
  %if &_bc_missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    %abort cancel;
  %end;
  %if &_bc_duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %abort cancel;
  %end;
%mend;
%_bc_validate;

/* Long rows are calculated once, then transposed to treatment columns. */
data work._bc_long;
  length row_order item_order 8 row_label $320 display_value $80
         trt_order 8 trt_label $200;
  stop;
run;

{% for item in items %}
{% if item.role == "categorical" %}
/* Categorical item: {{ item.label }} */
data work._bc_cat_source_{{ item.order }};
  set work._bc_source;
{% if not item.include_missing %}  if missing({{ item.variable }}) then delete;
{% endif %}  length level_value $400 sort_rank 8;
  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip(vvalue({{ item.variable }}));
{% if item.level_order == "custom" %}  sort_rank=1000000;
{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }};
{% endfor %}{% else %}  sort_rank=0;
{% endif %}run;

proc sql;
  create table work._bc_cat_freq_{{ item.order }} as
  select _bc_trt_key, level_value,
         count(distinct {{ subject }}) as numerator
  from work._bc_cat_source_{{ item.order }}
  group by _bc_trt_key, level_value;
  create table work._bc_cat_levels_{{ item.order }} as
  select level_value, min(sort_rank) as sort_rank
  from work._bc_cat_source_{{ item.order }}
  group by level_value;
quit;

proc sort data=work._bc_cat_levels_{{ item.order }};
  by sort_rank level_value;
run;

data work._bc_cat_levels_{{ item.order }};
  set work._bc_cat_levels_{{ item.order }};
  level_order=_n_;
run;

proc sql;
  create table work._bc_cat_{{ item.order }} as
  select t.trt_order, t._bc_trt_label as trt_label,
         t.big_n, l.level_order, l.level_value,
         coalesce(f.numerator,0) as numerator
  from work._bc_trt as t
  cross join work._bc_cat_levels_{{ item.order }} as l
  left join work._bc_cat_freq_{{ item.order }} as f
    on t._bc_trt_key=f._bc_trt_key
   and l.level_value=f.level_value
  order by t.trt_order, l.level_order;
quit;

data work._bc_item_{{ item.order }};
  length row_order item_order 8 row_label $320 display_value $80
         trt_order 8 trt_label $200;
  row_order={{ item.order }}*100000; item_order={{ item.order }};
  row_label={{ item.label | sas_string }}; display_value="";
  trt_order=1; trt_label=""; output;
  set work._bc_cat_{{ item.order }};
  row_order={{ item.order }}*100000+level_order;
  item_order={{ item.order }};
  row_label=cats("    ",level_value);
  display_value=cats(put(numerator,comma16.)," (",
                     put(round(100*numerator/big_n,10**(-{{ item.percent_digits }})),
                         16.{{ item.percent_digits }}),")");
  output;
run;

proc append base=work._bc_long data=work._bc_item_{{ item.order }} force; run;
{% else %}
/* Continuous item: {{ item.label }} */
proc means data=work._bc_source noprint vardef=df qntldef=5;
  class _bc_trt_key;
  var {{ item.variable }};
  output out=work._bc_stat_{{ item.order }}(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

proc sql;
  create table work._bc_cont_{{ item.order }} as
  select t.trt_order, t._bc_trt_label as trt_label, t.big_n,
         s.n, s.mean, s.std, s.median, s.q1, s.q3, s.min, s.max
  from work._bc_trt as t
  left join work._bc_stat_{{ item.order }} as s
    on t._bc_trt_key=s._bc_trt_key
  order by t.trt_order;
quit;

data work._bc_item_{{ item.order }};
  length row_order item_order 8 row_label $320 display_value $80
         trt_order 8 trt_label $200;
  row_order={{ item.order }}*100000; item_order={{ item.order }};
  row_label={{ item.label | sas_string }}; display_value="";
  trt_order=1; trt_label=""; output;
  set work._bc_cont_{{ item.order }};
  item_order={{ item.order }}; trt_label=trt_label;
{% if "n" in item.statistics %}  row_order={{ item.order }}*100000+1; row_label="    n";
  display_value=strip(put(n,comma16.)); output;
{% endif %}{% for key, label in (("mean", "Mean"), ("std", "SD"), ("median", "Median")) %}{% if key in item.statistics %}  row_order={{ item.order }}*100000+{{ loop.index + 1 }}; row_label="    {{ label }}";
  _dec={{ item.statistic_decimals[key] }};
  display_value=ifc(missing({{ key }}),"-",strip(putn(round({{ key }},10**(-_dec)),cats("32.",_dec)))); output;
{% endif %}{% endfor %}{% if "q1" in item.statistics %}  row_order={{ item.order }}*100000+5; row_label="    Q1, Q3";
  _dec1={{ item.statistic_decimals.q1 }}; _dec2={{ item.statistic_decimals.q3 }};
  display_value=cats(ifc(missing(q1),"-",strip(putn(round(q1,10**(-_dec1)),cats("32.",_dec1)))),", ",
                     ifc(missing(q3),"-",strip(putn(round(q3,10**(-_dec2)),cats("32.",_dec2))))); output;
{% endif %}{% if "min" in item.statistics %}  row_order={{ item.order }}*100000+6; row_label="    Min, Max";
  _dec1={{ item.statistic_decimals.min }}; _dec2={{ item.statistic_decimals.max }};
  display_value=cats(ifc(missing(min),"-",strip(putn(round(min,10**(-_dec1)),cats("32.",_dec1)))),", ",
                     ifc(missing(max),"-",strip(putn(round(max,10**(-_dec2)),cats("32.",_dec2))))); output;
{% endif %}  keep row_order item_order row_label display_value trt_order trt_label;
run;

proc append base=work._bc_long data=work._bc_item_{{ item.order }} force; run;
{% endif %}
{% endfor %}

/* Final wide result: treatment columns follow the runtime Population order. */
proc sort data=work._bc_long;
  by row_order trt_order;
run;

%macro _bc_wide;
proc sql;
  create table work._bc_wide as
  select row_order, max(row_label) as row_label length=320
  %do _i=1 %to &_bc_ntrt;
       , max(case when trt_order=&_i then display_value else "" end)
           as TRT_&_i length=80
  %end;
  from work._bc_long
  group by row_order
  order by row_order;
quit;
%mend;
%_bc_wide;

%macro _bc_finish;
data {{ output }}(label={{ header_label | sas_string }});
  set work._bc_wide;
  label row_label="Characteristic"
  %do _i=1 %to &_bc_ntrt;
        TRT_&_i="&&_bc_label_&_i"
  %end;
  ;
  keep row_label TRT_1-TRT_&_bc_ntrt;
run;
%mend;
%_bc_finish;

data {{ long_output }};
  set work._bc_long;
  value=display_value;
  keep row_order row_label value trt_order trt_label;
run;

proc datasets library=work nolist;
  delete _bc_source _bc_trt_: _bc_cat_: _bc_stat_: _bc_cont_:
         _bc_item_: _bc_long _bc_wide;
quit;
