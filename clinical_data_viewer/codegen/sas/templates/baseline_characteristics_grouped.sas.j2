/* Baseline Characteristics generated by SASDataViewer.
   Treatment columns are resolved from the Population Dataset.
   The final shell has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data {{ source.work_prefix }}_source;
  length trt_key trt_label $200;
  set {{ source.reference }};
  where {% if where_expression %}{{ where_expression }} and {% endif %}^missing({{ treatment.source }});
{% if treatment.source_kind == "numeric" %}  trt_key=strip(put({{ treatment.source }},best32.));
{% else %}  trt_key=strip({{ treatment.source }});
{% endif %}  trt_label=trt_key;
run;

/* Population N */
proc sql noprint;
{% for count in population_counts %}  select count(distinct {{ subject }}) into :{{ count.macro }} trimmed from {{ population.reference }}{% if population_where_expression %} where {{ population_where_expression }} and {{ treatment.population }}={{ count.population_literal }};{% else %} where {{ treatment.population }}={{ count.population_literal }};{% endif %}
{% endfor %}  select count(distinct {{ subject }}) into :{{ total_n_macro }} trimmed from {{ population.reference }}{% if population_where_expression %} where {{ population_where_expression }} and ^missing({{ treatment.population }});{% else %} where ^missing({{ treatment.population }});{% endif %}
quit;

/* Treatment order and population counts */
data {{ source.work_prefix }}_trt;
  length trt_key trt_label $200 trt_order big_n 8;
{% for count in population_counts %}  trt_order={{ loop.index }};
  big_n=&{{ count.macro }};
{% if treatment.source_kind == "numeric" %}  trt_key=strip(put({{ count.source_literal }},best32.));
{% else %}  trt_key=strip({{ count.source_literal }});
{% endif %}  trt_label=trt_key;
  output;
{% endfor %}{% if include_total %}  trt_order={{ population_counts|length + 1 }};
  big_n=&{{ total_n_macro }};
  trt_key="TOTAL";
  trt_label="Total";
  output;
{% endif %}run;

/* Validate the analysis source subject structure */
%let duplicate_subject_ids=;
proc sql noprint;
  select count(*) into :missing_subject trimmed from {{ source.work_prefix }}_source where missing({{ subject }});
  select count(*)-count(distinct {{ subject }}) into :duplicate_subject trimmed from {{ source.work_prefix }}_source;
  select {{ subject }} into :duplicate_subject_ids separated by ', '
  from {{ source.work_prefix }}_source
  where ^missing({{ subject }})
  group by {{ subject }}
  having count(*) > 1
  order by {{ subject }};
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    data _null_;
      set {{ source.work_prefix }}_source;
      if missing({{ subject }}) then
        put "ERROR: Missing {{ subject }} at source observation " _n_ ".";
    run;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %put ERROR: Duplicate {{ subject }} values: &duplicate_subject_ids.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

/* Long rows are calculated once, then transposed to treatment columns. */

%macro baseline_continuous(
    var=,
    order=,
    label=,
    work_prefix=,
    mean_decimals=0,
    std_decimals=0,
    median_decimals=0,
    q1_decimals=0,
    q3_decimals=0,
    min_decimals=0,
    max_decimals=0
);
proc means data=&work_prefix._source noprint nway missing
    vardef=df qntldef=5;
  class trt_key;
  var &var.;
  output out=&work_prefix._stat_&order.
{% for statistic in continuous_statistics %}    {{ statistic }}={{ statistic }}{% if not loop.last %} {% endif %}{% endfor %};
run;
{% if include_total %}
proc means data=&work_prefix._source noprint vardef=df qntldef=5;
  var &var.;
  output out=&work_prefix._stat_total_raw_&order.
{% for statistic in continuous_statistics %}    {{ statistic }}={{ statistic }}{% if not loop.last %} {% endif %}{% endfor %};
run;

data &work_prefix._stat_total_&order.;
  length trt_key $200;
  set &work_prefix._stat_total_raw_&order.;
  trt_key="TOTAL";
run;

data &work_prefix._stat_all_&order.;
  set &work_prefix._stat_&order. &work_prefix._stat_total_&order.;
run;
{% endif %}

proc sql;
  create table &work_prefix._cont_&order. as
  select t.trt_order, t.trt_label, t.big_n
{% for statistic in continuous_statistics %}         , s.{{ statistic }}
{% endfor %}  from &work_prefix._trt as t
{% if include_total %}  left join &work_prefix._stat_all_&order. as s
{% else %}  left join &work_prefix._stat_&order. as s
{% endif %}
    on t.trt_key=s.trt_key
  order by t.trt_order;
quit;

data &work_prefix._item_&order.;
  length row_order item_order 8 row_label $200 row_value $200
         trt_order 8 trt_label $200 statistic_key $200 cnt1 cnt2 $200;
  set &work_prefix._cont_&order.;
  if _n_=1 then do;
    row_order=&order.*1000;
    item_order=&order.;
    row_label=&label.;
    row_value="";
    statistic_key="";
    trt_order=1;
    trt_label="";
    output;

  end;
  item_order=&order.;
  trt_label=trt_label;
{% if "n" in continuous_statistics %}  row_order=&order.*1000+1;
  statistic_key="n";
  row_label="    n";
  row_value=strip(put(n,best.));
  output;

{% endif %}{% if "mean" in continuous_statistics %}  row_order=&order.*1000+2;
  statistic_key="mean";
  row_label="    Mean";
  row_value=strip(put(mean,8.&mean_decimals.));
  if missing(mean) then row_value="-";
  output;

{% endif %}{% if "std" in continuous_statistics %}  row_order=&order.*1000+3;
  statistic_key="std";
  row_label="    SD";
  row_value=strip(put(std,8.&std_decimals.));
  if missing(std) then row_value="-";
  output;

{% endif %}{% if "median" in continuous_statistics %}  row_order=&order.*1000+4;
  statistic_key="median";
  row_label="    Median";
  row_value=strip(put(median,8.&median_decimals.));
  if missing(median) then row_value="-";
  output;

{% endif %}{% if "q1" in continuous_statistics %}  row_order=&order.*1000+5;
  statistic_key="q1_q3";
  row_label="    Q1, Q3";
  cnt1=strip(put(q1,8.&q1_decimals.));
  cnt2=strip(put(q3,8.&q3_decimals.));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2);
  output;

{% endif %}{% if "min" in continuous_statistics %}  row_order=&order.*1000+6;
  statistic_key="min_max";
  row_label="    Min, Max";
  cnt1=strip(put(min,8.&min_decimals.));
  cnt2=strip(put(max,8.&max_decimals.));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2);
  output;

{% endif %}
  keep row_order item_order row_label row_value trt_order trt_label statistic_key;
run;

%mend baseline_continuous;

%macro baseline_categorical(
    var=,
    order=,
    label=,
    work_prefix=,
    subject=,
    storage_type=character,
    include_missing=0,
    include_total=0,
    level_order=runtime_value_ascending,
    percent_digits=1,
    round_increment=0.1,
    custom_sort=,
    custom_display=
);
data &work_prefix._cat_source_&order.;
  length level_value $200 sort_rank 8;
  set &work_prefix._source;
%if &include_missing.=0 %then %do;
  if ^missing(&var.);
%if &storage_type.=numeric %then %do;
  level_value=strip(put(&var.,best32.));
%end;
%else %do;
  level_value=strip(&var.);
%end;
%end;
%else %do;
  if missing(&var.) then level_value="Missing";
  else do;
%if &storage_type.=numeric %then %do;
    level_value=strip(put(&var.,best32.));
%end;
%else %do;
    level_value=strip(&var.);
%end;
  end;
%end;
%if &level_order.=custom %then %do;
  sort_rank=1000000;
  %unquote(&custom_sort.)
%end;
%else %do;
  sort_rank=0;
%end;
run;

proc sql;
  create table &work_prefix._cat_freq_&order. as
  select trt_key, level_value, count(distinct &subject.) as numerator
  from &work_prefix._cat_source_&order.
  group by trt_key, level_value;
%if &include_total.=1 %then %do;
  insert into &work_prefix._cat_freq_&order.
  select "TOTAL", level_value, count(distinct &subject.) as numerator
  from &work_prefix._cat_source_&order.
  group by level_value;
%end;
  create table &work_prefix._cat_levels_&order. as
  select level_value, min(sort_rank) as sort_rank
  from &work_prefix._cat_source_&order.
  group by level_value;
quit;

proc sort data=&work_prefix._cat_levels_&order.;
  by sort_rank level_value;
run;

data &work_prefix._cat_levels_&order.;
  set &work_prefix._cat_levels_&order.;
  level_order=_n_;
run;

proc sql;
  create table &work_prefix._cat_&order. as
  select t.trt_order, t.trt_label, t.big_n,
         l.level_order, l.level_value,
         coalesce(f.numerator,0) as numerator
  from &work_prefix._trt as t
  cross join &work_prefix._cat_levels_&order. as l
  left join &work_prefix._cat_freq_&order. as f
    on t.trt_key=f.trt_key
   and l.level_value=f.level_value
  order by t.trt_order, l.level_order;
quit;

data &work_prefix._item_&order.;
  length row_order item_order 8 row_label $200 row_value $200
         trt_order 8 trt_label $200 display_level $200 cnt1 cnt2 $200;
  set &work_prefix._cat_&order.;
  if _n_=1 then do;
    row_order=&order.*1000;
    item_order=&order.;
    row_label=&label.;
    row_value="";
    trt_order=1;
    trt_label="";
    output;

  end;
  row_order=&order.*1000+level_order;
  item_order=&order.;
  display_level=level_value;
%if &level_order.=custom and %length(%superq(custom_display)) > 0 %then %do;
  %unquote(&custom_display.)
%end;
  row_label=cats("    ",display_level);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(100*numerator/big_n,&round_increment.),
                         16.&percent_digits.),")");
  output;

run;

%mend baseline_categorical;

{% for item in items %}
{% if item.role == "categorical" %}
/* Categorical item: {{ item.label }} */
%baseline_categorical(
    var={{ item.variable }},
    order={{ item.order }},
    label=%str({{ item.label | sas_string }}),
    work_prefix={{ source.work_prefix }},
    subject={{ subject }},
    storage_type={{ item.storage_type }},
    include_missing={{ 1 if item.include_missing else 0 }},
    include_total={{ 1 if include_total else 0 }},
    level_order={{ item.level_order }},
    percent_digits={{ item.percent_digits }},
    round_increment={{ item.percent_digits | sas_round_increment }},
    custom_sort=%str({% if item.level_order == "custom" %}{% for level in item.custom_levels %}if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }}; {% endfor %}{% endif %}),
    custom_display=%str({% if item.level_order == "custom" %}{% for level in item.custom_levels %}{% if item.storage_type == "numeric" %}if level_value=strip(put({{ level.literal }},best32.)) then display_level={{ level.display | sas_string }}; {% elif level.literal == "''" %}if level_value="Missing" then display_level={{ level.display | sas_string }}; {% else %}if level_value={{ level.literal }} then display_level={{ level.display | sas_string }}; {% endif %}{% endfor %}{% endif %})
);

{% else %}
/* Continuous item: {{ item.label }} */
%baseline_continuous(
    var={{ item.variable }},
    order={{ item.order }},
    label=%str({{ item.label | sas_string }}),
    work_prefix={{ source.work_prefix }},
    mean_decimals={{ item.statistic_decimals.mean }},
    std_decimals={{ item.statistic_decimals.std }},
    median_decimals={{ item.statistic_decimals.median }},
    q1_decimals={{ item.statistic_decimals.q1 }},
    q3_decimals={{ item.statistic_decimals.q3 }},
    min_decimals={{ item.statistic_decimals.min }},
    max_decimals={{ item.statistic_decimals.max }}
);
{% endif %}
{% endfor %}

data {{ source.work_prefix }}_long;
  set
{% for item in items %}    {{ source.work_prefix }}_item_{{ item.order }}
{% endfor %}  ;
run;

/* Final wide result */
proc sort data={{ source.work_prefix }}_long;
  by row_order trt_order;
run;

proc sql;
  create table {{ source.work_prefix }}_wide as
  select row_order, max(row_label) as row_label length=200
{% for label in treatment_labels %}       , max(case when trt_order={{ loop.index }} then row_value else "" end)
           as {{ label.column }} length=200
{% endfor %}  from {{ source.work_prefix }}_long
  group by row_order
  order by row_order;
quit;

data {{ output }};
  set {{ source.work_prefix }}_wide;
  label row_label=""
{% for label in treatment_labels %}        {{ label.column }}={{ label.text | sas_double_string }}
{% endfor %}  ;
  keep row_label{% for label in treatment_labels %} {{ label.column }}{% endfor %};
run;

proc datasets library=work nolist;
  delete {{ source.work_prefix }}_source {{ source.work_prefix }}_trt:
         {{ source.work_prefix }}_cat: {{ source.work_prefix }}_stat:
         {{ source.work_prefix }}_cont: {{ source.work_prefix }}_item:
         {{ source.work_prefix }}_long {{ source.work_prefix }}_wide;
quit;
