/* Baseline Characteristics generated by SASDataViewer.
   Treatment columns are resolved from the Population Dataset.
   The final shell has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data work.{{ source.work_prefix }}_source;
  length trt_key trt_label $200;
  set {{ source.library }}.{{ source.member }};
  where {% if where_expression %}{{ where_expression }} and {% endif %}^missing({{ treatment.source }});
{% if treatment.source_kind == "numeric" %}  trt_key=strip(put({{ treatment.source }},best32.));
{% else %}  trt_key=strip({{ treatment.source }});
{% endif %}  trt_label=trt_key;
run;

/* Population N */
proc sql noprint;
{% for count in population_counts %}  select count(distinct {{ subject }}) into :{{ count.macro }} trimmed from {{ population.library }}.{{ population.member }}{% if population_where_expression %} where {{ population_where_expression }} and {{ treatment.population }}={{ count.population_literal }};{% else %} where {{ treatment.population }}={{ count.population_literal }};{% endif %}
{% endfor %}  select count(distinct {{ subject }}) into :{{ total_n_macro }} trimmed from {{ population.library }}.{{ population.member }}{% if population_where_expression %} where {{ population_where_expression }} and ^missing({{ treatment.population }});{% else %} where ^missing({{ treatment.population }});{% endif %}
quit;

/* Treatment order and population counts */
data work.{{ source.work_prefix }}_trt;
  length trt_key trt_label $200 trt_order big_n 8;
{% for count in population_counts %}  trt_order={{ loop.index }};
  big_n=&{{ count.macro }};
{% if treatment.source_kind == "numeric" %}  trt_key=strip(put({{ count.source_literal }},best32.));
{% else %}  trt_key=strip({{ count.source_literal }});
{% endif %}  trt_label=trt_key;
  output;
{% endfor %}{% if include_total %}  trt_order={{ population_counts|length + 1 }};
  big_n=&{{ total_n_macro }};
  trt_key="TOTAL";
  trt_label="Total";
  output;
{% endif %}run;

/* Validate the analysis source subject structure */
%let duplicate_subject_ids=;
proc sql noprint;
  select count(*) into :missing_subject trimmed from work.{{ source.work_prefix }}_source where missing({{ subject }});
  select count(*)-count(distinct {{ subject }}) into :duplicate_subject trimmed from work.{{ source.work_prefix }}_source;
  select {{ subject }} into :duplicate_subject_ids separated by ', '
  from work.{{ source.work_prefix }}_source
  where ^missing({{ subject }})
  group by {{ subject }}
  having count(*) > 1
  order by {{ subject }};
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    data _null_;
      set work.{{ source.work_prefix }}_source;
      if missing({{ subject }}) then
        put "ERROR: Missing {{ subject }} at source observation " _n_ ".";
    run;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %put ERROR: Duplicate {{ subject }} values: &duplicate_subject_ids.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

/* Long rows are calculated once, then transposed to treatment columns. */

%macro baseline_continuous(
    var=,
    order=,
    label=,
    work_prefix=,
    include_total=0,
    include_n=0,
    include_mean=0,
    include_std=0,
    include_median=0,
    include_q1_q3=0,
    include_min_max=0,
    mean_decimals=0,
    std_decimals=0,
    median_decimals=0,
    q1_decimals=0,
    q3_decimals=0,
    min_decimals=0,
    max_decimals=0
);
proc means data=work.&work_prefix._source noprint nway missing
    vardef=df qntldef=5;
  class trt_key;
  var &var.;
  output out=work.&work_prefix._stat_raw_&order.
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data work.&work_prefix._stat_&order.;
  set work.&work_prefix._stat_raw_&order.;
  keep trt_key %if &include_n %then %do; n %end;%if &include_mean %then %do; mean %end;%if &include_std %then %do; std %end;%if &include_median %then %do; median %end;%if &include_q1_q3 %then %do; q1 q3 %end;%if &include_min_max %then %do; min max %end;;
run;
%if &include_total %then %do;
proc means data=work.&work_prefix._source noprint vardef=df qntldef=5;
  var &var.;
  output out=work.&work_prefix._stat_total_raw_&order.
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data work.&work_prefix._stat_total_&order.;
  length trt_key $200;
  set work.&work_prefix._stat_total_raw_&order.;
  trt_key="TOTAL";
  keep trt_key %if &include_n %then %do; n %end;%if &include_mean %then %do; mean %end;%if &include_std %then %do; std %end;%if &include_median %then %do; median %end;%if &include_q1_q3 %then %do; q1 q3 %end;%if &include_min_max %then %do; min max %end;;
run;

data work.&work_prefix._stat_all_&order.;
  set work.&work_prefix._stat_&order. work.&work_prefix._stat_total_&order.;
run;
%end;

proc sql;
  create table work.&work_prefix._cont_&order. as
  select t.trt_order, t.trt_label, t.big_n
%if &include_n %then %do;         , s.n
%end;%if &include_mean %then %do;         , s.mean
%end;%if &include_std %then %do;         , s.std
%end;%if &include_median %then %do;         , s.median
%end;%if &include_q1_q3 %then %do;         , s.q1, s.q3
%end;%if &include_min_max %then %do;         , s.min, s.max
%end;  from work.&work_prefix._trt as t
%if &include_total %then %do;  left join work.&work_prefix._stat_all_&order. as s
%end;%else %do;  left join work.&work_prefix._stat_&order. as s
%end;
    on t.trt_key=s.trt_key
  order by t.trt_order;
quit;

data work.&work_prefix._item_&order.;
  length row_order item_order 8 row_label $200 row_value $200
         trt_order 8 trt_label $200 cnt1 cnt2 $200;
  row_order=&order.*100000; item_order=&order.;
  row_label=&label.; row_value="";
  trt_order=1; trt_label=""; output;
  set work.&work_prefix._cont_&order.;
  item_order=&order.; trt_label=trt_label;
%if &include_n %then %do;  row_order=&order.*100000+1; row_label="    n";
  row_value=strip(put(n,best.)); output;
%end;%if &include_mean %then %do;  row_order=&order.*100000+2; row_label="    Mean";
  row_value=strip(put(mean,8.&mean_decimals.));
  if missing(mean) then row_value="-";
  output;
%end;%if &include_std %then %do;  row_order=&order.*100000+3; row_label="    SD";
  row_value=strip(put(std,8.&std_decimals.));
  if missing(std) then row_value="-";
  output;
%end;%if &include_median %then %do;  row_order=&order.*100000+4; row_label="    Median";
  row_value=strip(put(median,8.&median_decimals.));
  if missing(median) then row_value="-";
  output;
%end;%if &include_q1_q3 %then %do;  row_order=&order.*100000+5; row_label="    Q1, Q3";
  cnt1=strip(put(q1,8.&q1_decimals.));
  cnt2=strip(put(q3,8.&q3_decimals.));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
%end;%if &include_min_max %then %do;  row_order=&order.*100000+6; row_label="    Min, Max";
  cnt1=strip(put(min,8.&min_decimals.));
  cnt2=strip(put(max,8.&max_decimals.));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
%end;  keep row_order item_order row_label row_value trt_order trt_label;
run;

%mend baseline_continuous;

{% for item in items %}
{% if item.role == "categorical" %}
/* Categorical item: {{ item.label }} */
data work.{{ source.work_prefix }}_cat_source_{{ item.order }};
  length level_value $200 sort_rank 8;
  set work.{{ source.work_prefix }}_source;
{% if not item.include_missing %}  if ^missing({{ item.variable }});
{% if item.storage_type == "numeric" %}  level_value=strip(put({{ item.variable }},best32.));
{% else %}  level_value=strip({{ item.variable }});
{% endif %}{% else %}{% if item.storage_type == "numeric" %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip(put({{ item.variable }},best32.));
{% else %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip({{ item.variable }});
{% endif %}{% endif %}{% if item.level_order == "custom" %}  sort_rank=1000000;
{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }};
{% endfor %}{% else %}  sort_rank=0;
{% endif %}run;

proc sql;
  create table work.{{ source.work_prefix }}_cat_freq_{{ item.order }} as
  select trt_key, level_value, count(distinct {{ subject }}) as numerator
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by trt_key, level_value;
{% if include_total %}  insert into work.{{ source.work_prefix }}_cat_freq_{{ item.order }}
  select "TOTAL", level_value, count(distinct {{ subject }}) as numerator
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by level_value;
{% endif %}  create table work.{{ source.work_prefix }}_cat_levels_{{ item.order }} as
  select level_value, min(sort_rank) as sort_rank
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by level_value;
quit;

proc sort data=work.{{ source.work_prefix }}_cat_levels_{{ item.order }};
  by sort_rank level_value;
run;

data work.{{ source.work_prefix }}_cat_levels_{{ item.order }};
  set work.{{ source.work_prefix }}_cat_levels_{{ item.order }};
  level_order=_n_;
run;

proc sql;
  create table work.{{ source.work_prefix }}_cat_{{ item.order }} as
  select t.trt_order, t.trt_label, t.big_n,
         l.level_order, l.level_value,
         coalesce(f.numerator,0) as numerator
  from work.{{ source.work_prefix }}_trt as t
  cross join work.{{ source.work_prefix }}_cat_levels_{{ item.order }} as l
  left join work.{{ source.work_prefix }}_cat_freq_{{ item.order }} as f
    on t.trt_key=f.trt_key
   and l.level_value=f.level_value
  order by t.trt_order, l.level_order;
quit;

data work.{{ source.work_prefix }}_item_{{ item.order }};
  length row_order item_order 8 row_label $200 row_value $200
         trt_order 8 trt_label $200 display_level $200 cnt1 cnt2 $200;
  row_order={{ item.order }}*100000; item_order={{ item.order }};
  row_label={{ item.label | sas_string }}; row_value="";
  trt_order=1; trt_label=""; output;
  set work.{{ source.work_prefix }}_cat_{{ item.order }};
  row_order={{ item.order }}*100000+level_order;
  item_order={{ item.order }};
  display_level=level_value;
{% if item.level_order == "custom" %}{% for level in item.custom_levels %}{% if item.storage_type == "numeric" %}  if level_value=strip(put({{ level.literal }},best32.)) then display_level={{ level.display | sas_string }};
{% elif level.literal == "''" %}  if level_value="Missing" then display_level={{ level.display | sas_string }};
{% else %}  if level_value={{ level.literal }} then display_level={{ level.display | sas_string }};
{% endif %}{% endfor %}{% endif %}  row_label=cats("    ",display_level);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(100*numerator/big_n,{{ item.percent_digits | sas_round_increment }}),
                         16.{{ item.percent_digits }}),")");
  output;
run;

{% else %}
/* Continuous item: {{ item.label }} */
%baseline_continuous(
    var={{ item.variable }},
    order={{ item.order }},
    label=%str({{ item.label | sas_string }}),
    work_prefix={{ source.work_prefix }},
    include_total={{ 1 if include_total else 0 }},
    include_n={{ 1 if "n" in item.statistics else 0 }},
    include_mean={{ 1 if "mean" in item.statistics else 0 }},
    include_std={{ 1 if "std" in item.statistics else 0 }},
    include_median={{ 1 if "median" in item.statistics else 0 }},
    include_q1_q3={{ 1 if "q1" in item.statistics else 0 }},
    include_min_max={{ 1 if "min" in item.statistics else 0 }},
    mean_decimals={{ item.statistic_decimals.mean }},
    std_decimals={{ item.statistic_decimals.std }},
    median_decimals={{ item.statistic_decimals.median }},
    q1_decimals={{ item.statistic_decimals.q1 }},
    q3_decimals={{ item.statistic_decimals.q3 }},
    min_decimals={{ item.statistic_decimals.min }},
    max_decimals={{ item.statistic_decimals.max }}
);
{% endif %}
{% endfor %}

data work.{{ source.work_prefix }}_long;
  set
{% for item in items %}    work.{{ source.work_prefix }}_item_{{ item.order }}
{% endfor %}  ;
run;

/* Final wide result */
proc sort data=work.{{ source.work_prefix }}_long;
  by row_order trt_order;
run;

proc sql;
  create table work.{{ source.work_prefix }}_wide as
  select row_order, max(row_label) as row_label length=200
{% for label in treatment_labels %}       , max(case when trt_order={{ loop.index }} then row_value else "" end)
           as {{ label.column }} length=200
{% endfor %}  from work.{{ source.work_prefix }}_long
  group by row_order
  order by row_order;
quit;

data {{ output }}(label={{ header_label | sas_string }});
  set work.{{ source.work_prefix }}_wide;
  label row_label="Characteristic"
{% for label in treatment_labels %}        {{ label.column }}={{ label.text | sas_double_string }}
{% endfor %}  ;
  keep row_label{% for label in treatment_labels %} {{ label.column }}{% endfor %};
run;

data {{ long_output }};
  set work.{{ source.work_prefix }}_long;
  value=row_value;
  keep row_order row_label value trt_order trt_label;
run;

proc datasets library=work nolist;
  delete {{ source.work_prefix }}_source {{ source.work_prefix }}_trt:
         {{ source.work_prefix }}_cat: {{ source.work_prefix }}_stat:
         {{ source.work_prefix }}_cont: {{ source.work_prefix }}_item:
         {{ source.work_prefix }}_long {{ source.work_prefix }}_wide;
quit;
