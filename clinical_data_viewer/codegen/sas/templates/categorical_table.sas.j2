/*
   Generated by SASDataViewer
   Categorical Table configuration version {{ version }}
   Reference engine: python_categorical_v1
   Source: {{ source_reference }}
   Treatment: {{ treatment }}
   Count: {{ "distinct " ~ subject if count_type == "distinct_subjects" else "records" }}
   Denominator: {{ denominator.type }}
   Total enabled: {{ "true" if total_enabled else "false" }}
   Percent digits: {{ digits }}
*/
options validvarname=any;

/* Prepare source data */
{% if source.format == "xpt" %}
libname {{ source_library }} xport {{ source.source_path | sas_string }};
{% else %}
libname {{ source_library }} {{ source.source_directory | sas_string }};
{% endif %}

data cat_src;
    set {{ source_reference }};
{% if numerator_filter %}    if not ({{ numerator_filter }}) then delete;
{% endif %}    if missing({{ treatment }}) then do;
        put "ERROR: Categorical source contains missing treatment values.";
        abort cancel;
    end;
run;
{% if denominator.type == "population" %}

/* Prepare the independent population denominator */
{% if denominator.population.input.format == "xpt" %}
libname {{ denominator.population.library }} xport {{ denominator.population.input.source_path | sas_string }};
{% else %}
libname {{ denominator.population.library }} {{ denominator.population.input.source_directory | sas_string }};
{% endif %}

data pop_src;
    set {{ denominator.population.reference }};
{% if denominator.population.filter %}    if not ({{ denominator.population.filter }}) then delete;
{% endif %}    if missing({{ denominator_treatment }}) then do;
        put "ERROR: Population denominator contains missing treatment values.";
        abort cancel;
    end;
run;
{% endif %}
{% if output_columns %}
{% for item in items %}

/* Item {{ item.order }}: {{ item.variable_label }} */
{% if denominator.type == "baseline_postbaseline" %}
/* Identify subjects with an eligible baseline record for this Item context. */
proc sql;
    create table {{ item.members.baseline }} as
    select distinct
{% for context in item.contexts %}        {{ context.name }} as {{ context.alias }},
{% endfor %}        {{ treatment }} as _trt,
        {{ subject }} as _subjid
    from cat_src{% if denominator.baseline_filter %}(where=({{ denominator.baseline_filter }})){% endif %}
    where not missing({{ denominator.analysis_value }})
      and not missing({{ subject }});
quit;

data {{ item.members.postbaseline }};
    set cat_src{% if denominator.postbaseline_filter %}(where=({{ denominator.postbaseline_filter }})){% endif %};
    if missing({{ denominator.analysis_value }}) then delete;
run;

/* Keep eligible postbaseline records without collapsing duplicate records. */
proc sql;
    create table {{ item.members.eligible }} as
    select p.*
    from {{ item.members.postbaseline }} as p
    inner join {{ item.members.baseline }} as b
        on p.{{ treatment }} = b._trt
       and p.{{ subject }} = b._subjid
{% for context in item.contexts %}       and (
               p.{{ context.name }} = b.{{ context.alias }}
            or (missing(p.{{ context.name }}) and missing(b.{{ context.alias }}))
       )
{% endfor %}    ;
quit;
{% endif %}

/* Calculate this Item denominator.  The Item level is deliberately excluded. */
proc sql;
    create table {{ item.members.denominator }} as
    select
{% for context in item.contexts %}        {% if denominator.type == "population" %}{{ context.denominator_name }}{% else %}{{ context.name }}{% endif %} as {{ context.alias }},
{% endfor %}{% for level in levels %}{% if count_type == "distinct_subjects" %}        count(distinct (case when {{ denominator_treatment }} = {{ level.literal }} then {{ denominator_subject }} end)) as denom{{ level.order }}{% else %}        sum(case when {{ denominator_treatment }} = {{ level.literal }} then 1 else 0 end) as denom{{ level.order }}{% endif %}{% if not loop.last or total_enabled %},{% endif %}
{% endfor %}{% if total_enabled %}{% if count_type == "distinct_subjects" %}        count(distinct (case when not missing({{ denominator_treatment }}) then {{ denominator_subject }} end)) as denom{{ total_order }}
{% else %}        sum(case when not missing({{ denominator_treatment }}) then 1 else 0 end) as denom{{ total_order }}
{% endif %}{% endif %}    from {% if denominator.type == "population" %}pop_src{% elif denominator.type == "baseline_postbaseline" %}{{ item.members.eligible }}{% else %}cat_src{% endif %}
    where 1 = 1{% if count_type == "distinct_subjects" %}
      and not missing({{ denominator_subject }}){% endif %}{% if denominator.type == "nonmissing" %}
      and not missing({{ denominator.analysis_value }}){% endif %}
{% if item.contexts %}    group by
{% for context in item.contexts %}        {% if denominator.type == "population" %}{{ context.denominator_name }}{% else %}{{ context.name }}{% endif %}{% if not loop.last %},{% endif %}
{% endfor %}{% endif %}    ;
quit;

/* Count every runtime level for this Item. */
proc sql;
    create table {{ item.members.numerator }} as
    select
{% for context in item.contexts %}        {{ context.name }} as {{ context.alias }},
{% endfor %}        {{ item.variable }} as level,
{% for level in levels %}{% if count_type == "distinct_subjects" %}        count(distinct (case when {{ treatment }} = {{ level.literal }} then {{ subject }} end)) as count{{ level.order }}{% else %}        sum(case when {{ treatment }} = {{ level.literal }} then 1 else 0 end) as count{{ level.order }}{% endif %}{% if not loop.last or total_enabled %},{% endif %}
{% endfor %}{% if total_enabled %}{% if count_type == "distinct_subjects" %}        count(distinct (case when not missing({{ treatment }}) then {{ subject }} end)) as count{{ total_order }}
{% else %}        sum(case when not missing({{ treatment }}) then 1 else 0 end) as count{{ total_order }}
{% endif %}{% endif %}    from {% if denominator.type == "baseline_postbaseline" %}{{ item.members.eligible }}{% else %}cat_src{% endif %}
    where 1 = 1{% if count_type == "distinct_subjects" %}
      and not missing({{ subject }}){% endif %}{% if not item.include_missing %}
      and not missing({{ item.variable }}){% endif %}
    group by
{% for context in item.contexts %}        {{ context.name }},
{% endfor %}        {{ item.variable }};
quit;

/* Attach the context denominator and build stable runtime sort keys. */
proc sql;
    create table {{ item.members.calculation }} as
    select
        n.*,
{% for level in levels %}        coalesce(d.denom{{ level.order }}, 0) as denom{{ level.order }}{% if not loop.last or total_enabled %},{% endif %}
{% endfor %}{% if total_enabled %}        coalesce(d.denom{{ total_order }}, 0) as denom{{ total_order }}
{% endif %}    from {{ item.members.numerator }} as n
    left join {{ item.members.denominator }} as d
{% if item.contexts %}        on
{% for context in item.contexts %}           (
                n.{{ context.alias }} = d.{{ context.alias }}
             or (missing(n.{{ context.alias }}) and missing(d.{{ context.alias }}))
           ){% if not loop.last %} and{% endif %}
{% endfor %}{% else %}        on 1 = 1
{% endif %}    ;
quit;

data {{ item.members.calculation }};
    set {{ item.members.calculation }};
{% for context in item.contexts %}{% if context.kind == "character" %}    length {{ context.alias }}_key ${{ context.length }};
{% endif %}{% endfor %}{% if item.kind == "character" %}    length level_key ${{ item.length }};
{% endif %}
{% for context in item.contexts %}    {{ context.alias }}_miss = missing({{ context.alias }});
{% if context.kind == "character" %}    {{ context.alias }}_key = lowcase({{ context.alias }});
{% else %}    {{ context.alias }}_key = {{ context.alias }};
{% endif %}{% endfor %}    level_miss = missing(level);
{% if item.kind == "character" %}    level_key = lowcase(level);
{% else %}    level_key = level;
{% endif %}run;

proc sort data={{ item.members.calculation }};
    by
{% for context in item.contexts %}        {{ context.alias }}_miss {{ context.alias }}_key {{ context.alias }}
{% endfor %}        level_miss level_key level
    ;
run;

/* Build this Item's clinical rows and auditable long result. */
data {{ item.members.rows }}(keep=item col1-col{{ output_columns }})
     {{ item.members.long }}(
         keep=item_order item_variable item_label context level_text treatment
              trt_order freq denom pct
     );
    set {{ item.members.calculation }};
    by
{% for context in item.contexts %}        {{ context.alias }}_miss {{ context.alias }}_key {{ context.alias }}
{% endfor %}        level_miss level_key level
    ;
    length item item_variable item_label level_text treatment _ctx_value $200
           context $1000;
    length col1-col{{ output_columns }} $200;

    context = '';
{% for context in item.contexts %}    if missing({{ context.alias }}) then
        _ctx_value = '(Missing)';
{% if context.kind == "character" %}    else _ctx_value = strip({{ context.alias }});
{% else %}    else _ctx_value = strip(put({{ context.alias }}, best32.));
{% endif %}    context = catx(', ', context, cat({{ (context.label ~ '=') | sas_string }}, strip(_ctx_value)));
{% endfor %}
{% if item.contexts %}    if first.{{ item.contexts[-1].alias }} then do;
{% else %}    if _n_ = 1 then do;
{% endif %}        item = {{ item.label | sas_string }};
        if not missing(context) then
            item = cat(strip(item), ' — ', strip(context));
        call missing(of col1-col{{ output_columns }});
        output {{ item.members.rows }};
    end;

    if missing(level) then
        level_text = '(Missing)';
{% if item.kind == "character" %}    else level_text = strip(level);
{% else %}    else level_text = strip(put(level, best32.));
{% endif %}    item = cat('    ', strip(level_text));

    array cnt {*} count1-count{{ output_columns }};
    array den {*} denom1-denom{{ output_columns }};
    array col {*} $ col1-col{{ output_columns }};

    do i = 1 to dim(cnt);
        if den{i} = 0 then
            col{i} = '0 (—)';
        else do;
            _pct = cnt{i} / den{i} * 100;
            col{i} = cat(
                strip(put(cnt{i}, 3.)),
                ' (',
                strip(put(round(_pct, {{ round_increment }}), {{ percent_format }})),
                ')'
            );
        end;
    end;
    output {{ item.members.rows }};

    item_variable = {{ item.variable_label | sas_string }};
    item_label = {{ item.label | sas_string }};
    do i = 1 to dim(cnt);
        trt_order = i;
        select (i);
{% for level in levels %}            when ({{ level.order }}) treatment = {{ level.label | sas_string }};
{% endfor %}{% if total_enabled %}            when ({{ total_order }}) treatment = 'Total';
{% endif %}            otherwise treatment = '';
        end;
        freq = cnt{i};
        denom = den{i};
        if denom = 0 then pct = .;
        else pct = freq / denom * 100;
        item_order = {{ item.order }};
        output {{ item.members.long }};
    end;

    label item = 'Event';
run;
{% endfor %}

/* Combine configured Items in Builder order. */
data {{ output_dataset }};
    set
{% for item in items %}        {{ item.members.rows }}
{% endfor %}    ;
    label
        item = 'Event'
{% for level in levels %}        col{{ level.order }} = {{ (level.label ~ " n (%)") | sas_string }}
{% endfor %}{% if total_enabled %}        col{{ total_order }} = 'Total n (%)'
{% endif %}    ;
    keep item col1-col{{ output_columns }};
run;

data {{ long_output_dataset }};
    length level $200;
    set
{% for item in items %}        {{ item.members.long }}
{% endfor %}    ;
    level = level_text;
    keep item_order item_variable item_label context level treatment
         trt_order freq denom pct;
run;
{% else %}

/* No resolved treatment columns are available for this configuration. */
data {{ output_dataset }};
    length item $200;
    label item = 'Event';
    stop;
run;

data {{ long_output_dataset }};
    length item_variable item_label level_text treatment $200 context $1000;
    length item_order trt_order freq denom pct 8;
    stop;
run;
{% endif %}

/* Clean up intermediate WORK tables */
proc datasets library=work nolist;
    delete
        cat_src
{% if denominator.type == "population" %}        pop_src
{% endif %}{% if output_columns %}{% for item in items %}        {{ item.members.denominator }}
        {{ item.members.numerator }}
        {{ item.members.calculation }}
        {{ item.members.rows }}
        {{ item.members.long }}
{% if denominator.type == "baseline_postbaseline" %}        {{ item.members.baseline }}
        {{ item.members.postbaseline }}
        {{ item.members.eligible }}
{% endif %}{% endfor %}{% endif %}    ;
quit;
{% if denominator.type == "population" %}
libname {{ denominator.population.library }} clear;
{% endif %}
libname {{ source_library }} clear;
