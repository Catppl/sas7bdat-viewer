/*
   Generated by SASDataViewer
   Rule-based Table configuration version {{ version }}
   Reference engine: python_rule_based_v1
   Source: {{ source_reference }}
   Treatment: {{ treatment }}
   Count: distinct {{ subject }}
   Denominator: {{ denominator.type }}
   Total enabled: {{ "true" if total_enabled else "false" }}
   Percent digits: {{ digits }}
*/
options validvarname=any;
{% if source.format == "xpt" %}
libname {{ source_library }} xport {{ source.source_path | sas_string }};
{% else %}
libname {{ source_library }} {{ source.source_directory | sas_string }};
{% endif %}
{% if denominator.type == "population" %}
{% if denominator.population.input.format == "xpt" %}
libname population xport {{ denominator.population.input.source_path | sas_string }};
{% else %}
libname population {{ denominator.population.input.source_directory | sas_string }};
{% endif %}
{% endif %}

data {{ work_source }};
    set {{ source_reference }};
{% if dataset_filter %}    where {{ dataset_filter }};
{% endif %}run;

/* Treatment missing validation is intentionally performed before counting. */
{% for row in rows %}
data {{ row.source_member }};
    set {{ work_source }};
{% if row.filter %}    if not ({{ row.filter }}) then delete;
{% endif %}    if missing({{ treatment }}) then do;
        put "ERROR: Rule-based row {{ row.id }} ({{ row.item | replace('"', '""') }}) contains missing treatment values.";
        abort cancel;
    end;
run;
{% endfor %}
{% if denominator.type == "population" %}
data {{ work_population }};
    set population.{{ denominator.population.member }};
{% if denominator.population.filter %}    where {{ denominator.population.filter }};
{% endif %}run;

data _null_;
    set {{ work_population }};
    if missing({{ treatment }}) then do;
        put "ERROR: Population denominator contains missing treatment values.";
        abort cancel;
    end;
run;
{% endif %}

/* Denominator counts: Row Filters are deliberately not applied here. */
proc sql;
    create table {{ work_denominator }} as
    select {{ treatment }} as trt_value,
           count(distinct {{ subject }}) as denom
    from {% if denominator.type == "population" %}{{ work_population }}{% else %}{{ work_source }}{% endif %}
    where not missing({{ subject }}){% if denominator.type == "nonmissing" %}
      and not missing({{ denominator.analysis_value }}){% endif %}
    group by {{ treatment }};
    create table {{ work_denominator_total }} as
    select count(distinct {{ subject }}) as denom
    from {% if denominator.type == "population" %}{{ work_population }}{% else %}{{ work_source }}{% endif %}
    where not missing({{ subject }}){% if denominator.type == "nonmissing" %}
      and not missing({{ denominator.analysis_value }}){% endif %};
quit;
{% for row in rows %}
proc sql;
    create table {{ row.member }} as
    select {{ treatment }} as trt_value,
           count(distinct {{ subject }}) as freq
    from {{ row.source_member }}
    where not missing({{ subject }})
    group by {{ treatment }};
    create table {{ row.member }}_total as
    select count(distinct {{ subject }}) as freq
    from {{ row.source_member }}
    where not missing({{ subject }});
quit;
{% endfor %}

/* Keep one output row per configured rule, including an empty treatment universe. */
proc sql;
    create table {{ work_items }} as
{% for row in rows %}    select {{ row.order }} as row_order,
           {{ row.item | sas_string }} as item length=1024,
           {{ row.indent }} as indent
    from dictionary.tables(obs=1)
{% if not loop.last %}    union all
{% endif %}{% endfor %};
quit;

/* Long trace table preserves row order, treatment order, and numeric values. */
{% if long_branches %}
proc sql;
    create table {{ work_long }} as
{% for branch in long_branches %}    select {{ branch.row.order }} as row_order,
           {{ branch.row.id | sas_string }} as row_id length=64,
           {{ branch.row.item | sas_string }} as item length=1024,
           {{ branch.row.indent }} as indent,
           {{ branch.order }} as trt_order,
           {{ branch.literal }} as trt_value{% if treatment_kind == "character" %} length=200{% endif %},
           {{ branch.label | sas_string }} as trt_label length=200,
           {% if branch.total %}coalesce((select freq from {{ branch.frequency_table }}), 0){% else %}coalesce((select freq from {{ branch.frequency_table }} where trt_value = {{ branch.literal }}), 0){% endif %} as freq,
           {% if branch.total %}coalesce((select denom from {{ work_denominator_total }}), 0){% else %}coalesce((select denom from {{ work_denominator }} where trt_value = {{ branch.literal }}), 0){% endif %} as denom
    from dictionary.tables(obs=1)
{% if not loop.last %}    union all
{% endif %}{% endfor %};
quit;
{% else %}
data {{ work_long }};
    length row_order 8 row_id $64 item $1024 indent 8 trt_order 8
           trt_value $200 trt_label $200 freq 8 denom 8;
    stop;
run;
{% endif %}

data {{ work_long }};
    set {{ work_long }};
    length display $200;
    if denom = 0 then do;
        pct = .;
        display = '0 (—)';
    end;
    else do;
        pct = freq / denom * 100;
        display = cats(strip(put(freq, best.)), ' (',
            strip(put(round(pct, {{ round_increment }}), 32.{{ digits }})), ')');
    end;
run;

proc sql;
    create table {{ output_dataset }} as
    select (case when items.indent > 0
                 then repeat(' ', items.indent * 4 - 1)
                 else '' end) || strip(items.item) as ITEM length=1024
{% for level in levels %}        ,max(case when trt_order = {{ loop.index }} then display else '' end) as TRT_{{ loop.index }} length=200
{% endfor %}{% if total_enabled %}        ,max(case when trt_order = {{ levels | length + 1 }} then display else '' end) as TOTAL length=200
{% endif %}    from {{ work_items }} as items
    left join {{ work_long }} as long
      on long.row_order = items.row_order
    group by items.row_order, items.item, items.indent
    order by items.row_order;
quit;

data {{ output_dataset }};
    set {{ output_dataset }};
{% for level in levels %}    label TRT_{{ loop.index }}={{ (level.label ~ ' n (%)') | sas_string }};
{% endfor %}{% if total_enabled %}    label TOTAL='Total n (%)';
{% endif %}run;

proc datasets library=work nolist;
    delete {{ work_source }} {{ work_items }} {{ work_long }} {{ work_denominator }} {{ work_denominator_total }}
{% if denominator.type == "population" %}           {{ work_population }}
{% endif %}{% for row in rows %}           {{ row.source_member }} {{ row.member }} {{ row.member }}_total
{% endfor %}           ;
quit;
{% if denominator.type == "population" %}
libname population clear;
{% endif %}
libname {{ source_library }} clear;
