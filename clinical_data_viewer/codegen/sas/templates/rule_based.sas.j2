/*
   Generated by SASDataViewer
   Rule-based Table configuration version {{ version }}
   Reference engine: python_rule_based_v1
   Source: {{ source_reference }}
   Treatment: {{ treatment }}
   Count: distinct {{ subject }}
   Denominator: {{ denominator.type }}
   Total enabled: {{ "true" if total_enabled else "false" }}
   Percent digits: {{ digits }}
*/
options validvarname=any;

{% if denominator.type == "population" %}
/* Prepare the independent population denominator. */
{% if denominator.population.input.format == "xpt" %}
libname pop xport {{ denominator.population.input.source_path | sas_string }};
{% endif %}

data {{ work_population }};
    set {% if denominator.population.input.format == "xpt" %}pop{% else %}{{ source_library }}{% endif %}.{{ denominator.population.member }};
{% if denominator.population.filter %}    if {{ denominator.population.filter }};
{% endif %}run;

/* Population N by treatment group */
proc sql noprint;
{% for count in population_counts %}    select count(distinct {{ denominator_subject }}) into :{{ count.macro }} trimmed from {{ work_population }} where {{ denominator_treatment }} = {{ count.literal }};
{% endfor %}{% if total_enabled %}    select count(distinct {{ denominator_subject }}) into :{{ total_n_macro }} trimmed from {{ work_population }} where not missing({{ denominator_treatment }});
{% endif %}quit;
{% endif %}

/* Prepare source data */
{% if source.format == "xpt" %}
libname {{ source_library }} xport {{ source.source_path | sas_string }};
{% endif %}

data {{ work_source }};
    set {{ source_reference }};
{% if dataset_filter %}    if {{ dataset_filter }};
{% endif %}run;

/* Calculate denominators. Row filters are deliberately not applied here. */
{% if output_columns %}
proc sql;
    create table {{ work_denominator }} as
    select
{% for level in levels %}        count(distinct (case when {{ denominator_treatment }} = {{ level.literal }} then {{ denominator_subject }} end)) as denom{{ level.order }}{% if not loop.last or total_enabled %},{% endif %}
{% endfor %}{% if total_enabled %}        count(distinct (case when not missing({{ denominator_treatment }}) then {{ denominator_subject }} end)) as denom{{ total_order }}
{% endif %}    from {{ denominator_source }}
    where not missing({{ denominator_subject }}){% if denominator.type == "nonmissing" %}
      and not missing({{ denominator.analysis_value }}){% endif %};
quit;
{% else %}
data {{ work_denominator }};
    _denom = 0;
run;
{% endif %}

/* Calculate each configured Rule row independently. */
{% for row in rows %}
/* Row {{ row.order }}: {{ row.item }} */
proc sql;
    create table {{ row.member }} as
{% if output_columns %}    select
        {{ row.display_item | sas_string }} as item length=200,
{% for level in levels %}        count(distinct (case when {{ treatment }} = {{ level.literal }} then {{ subject }} end)) as count{{ level.order }}{% if not loop.last or total_enabled %},{% endif %}
{% endfor %}{% if total_enabled %}        count(distinct (case when not missing({{ treatment }}) then {{ subject }} end)) as count{{ total_order }}
{% endif %}    from {% if row.has_filter %}{{ work_source }}(where=({{ row.filter }})){% else %}{{ work_source }}{% endif %}
    where not missing({{ subject }});
{% else %}    select distinct
        {{ row.display_item | sas_string }} as item length=200
    from dictionary.tables(obs=1);
{% endif %}quit;
{% endfor %}

/* Combine all row counts before calculating percentages. */
data {{ work_counts }};
    set
{% for row in rows %}        {{ row.member }}
{% endfor %}    ;
run;

/* Calculate n (%) once, after all rows have been combined. */
data {{ output_dataset }};
{% if output_columns %}    if _n_ = 1 then set {{ work_denominator }};
{% endif %}    set {{ work_counts }};
{% if output_columns %}
    /* cnt = numerator counts, den = denominator counts, col = display values. */
    array cnt {*} count1-count{{ output_columns }};
    array den {*} denom1-denom{{ output_columns }};
    array col {*} $200 col1-col{{ output_columns }};

    do i = 1 to dim(cnt);
        if den{i} = 0 then
            col{i} = '0 (—)';
        else do;
            _pct = cnt{i} / den{i} * 100;
            col{i} = "   " || strip(put(cnt{i}, best.)) ||
                ' (' ||
                strip(put(round(_pct, {{ round_increment }}), {{ 4 + digits }}.{{ digits }})) ||
                ')';
        end;
    end;

    label
        item = 'Event'
{% for level in levels %}        col{{ level.order }} = {% if denominator.type == "population" %}{{ (level.label ~ " (N=&n" ~ level.order ~ ") n (%)") | sas_double_string }}{% else %}{{ (level.label ~ " n (%)") | sas_string }}{% endif %}
{% endfor %}{% if total_enabled %}{% if denominator.type == "population" %}        col{{ total_order }} = "Total (N=&{{ total_n_macro }}) n (%)"
{% else %}        col{{ total_order }} = 'Total n (%)'
{% endif %}
{% endif %}    ;

    keep item col1-col{{ output_columns }};
{% else %}
    keep item;
{% endif %}run;

/* Clean up intermediate WORK tables */
proc datasets library=work nolist;
    delete
        {{ work_source }}
{% if denominator.type == "population" %}        {{ work_population }}
{% endif %}{% for row in rows %}        {{ row.member }}
{% endfor %}        {{ work_counts }}
        {{ work_denominator }}
    ;
quit;
{% if denominator.type == "population" %}
{% if denominator.population.input.format == "xpt" %}
libname pop clear;
{% endif %}
{% endif %}
{% if source.format == "xpt" %}
libname {{ source_library }} clear;
{% endif %}
