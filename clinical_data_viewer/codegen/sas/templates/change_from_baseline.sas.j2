/*
   Generated by SASDataViewer
   Change from Baseline (Horizontal), JSON v1
   Source: {{ source_display }}
   Change variable: {{ change }}
   Item variable: {{ item }}
   Treatment columns: {{ treatment if treatment_columns else "none" }}
   Fixed treatment levels: {{ "yes" if treatment_columns else "no" }}
   Statistics: {{ statistics | join(", ") }}
   Total enabled: {{ "yes" if include_total else "no" }}
   Decimal policy: statistic-specific, maximum 4 places
*/

/* Prepare the filtered source and the shell-controlled display values. */
data cb_source;
    length _item_text _item_label _item_sort _trt_label $200
           _item_order 8
{% for row in rows %}           {{ row.missing_flag }} 8
{% endfor %}{% if treatment_columns %}           _trt_order 8
{% endif %}           ;
    set {{ source_display }}{% if where %}(where=({{ where }})){% endif %};
    if missing({{ item | sas_name }}) then _item_text = '(Missing)';
    else _item_text = {{ item_raw_text }};
    _item_label = _item_text;
    _item_order = 999999;
    _item_sort = lowcase(_item_text);
{% for case in item_cases %}    if {{ item | sas_name }} = {{ case.literal }} then _item_order = {{ case.order }};
{% endfor %}{% for case in label_cases %}    if _item_text = {{ case.value | sas_string }} then _item_label = {{ case.label | sas_string }};
{% endfor %}{% for row in rows %}    {{ row.missing_flag }} = missing({{ row.sas_name }});
{% endfor %}{% if treatment_columns %}    if missing({{ treatment | sas_name }}) then do;
        put "ERROR: Missing treatment values were found in the Change from Baseline source.";
        abort cancel;
    end;
    _trt_order = .;
{% for level in treatment_levels %}    if {{ treatment | sas_name }} = {{ level.literal }} then do;
        _trt_order = {{ level.order }};
        _trt_label = {{ level.label | sas_string }};
    end;
{% endfor %}    if missing(_trt_order) then do;
        put "ERROR: A treatment value is not present in the configured treatment levels.";
        abort cancel;
    end;
{% else %}    _trt_order = 1;
    _trt_label = 'All';
{% endif %}    if missing({{ subject | sas_name }}) then delete;
run;

/* Calculate statistics for each Item / Row / Treatment combination. */
proc means data=cb_source nway missing noprint vardef=df qntldef=5;
    class {{ class_group | join(' ') }};
    var {{ change | sas_name }};
    output out=cb_stat(drop=_TYPE_ _FREQ_)
{% for stat in stat_output %}        {{ stat.keyword }}={{ stat.name }}{% if not loop.last %}
{% endif %}{% endfor %}
    ;
run;

/* Count distinct subjects in the same groups; this is the large N. */
proc sql;
    create table cb_subject as
    select
{% for variable in class_group %}        {{ variable }}{% if not loop.last %},{% endif %}
{% endfor %}        ,count(distinct case
            when not missing({{ change | sas_name }})
             and not missing({{ subject | sas_name }})
            then {{ subject | sas_name }}
        end) as SUBJECT_N
    from cb_source
    group by {{ class_group | join(', ') }}
    ;
quit;

proc sql;
    create table cb_group as
    select s.*, q.SUBJECT_N
    from cb_stat as s
    left join cb_subject as q
      on {% for variable in class_group %}(
           s.{{ variable }} = q.{{ variable }}
           or (missing(s.{{ variable }}) and missing(q.{{ variable }}))
         ){% if not loop.last %} and{% endif %}
         {% endfor %}
    ;
quit;

/* Recompute Total independently; do not sum treatment columns. */
{% if include_total %}proc means data=cb_source nway missing noprint vardef=df qntldef=5;
    class {{ class_base | join(' ') }};
    var {{ change | sas_name }};
    output out=cb_total_stat(drop=_TYPE_ _FREQ_)
{% for stat in stat_output %}        {{ stat.keyword }}={{ stat.name }}{% if not loop.last %}
{% endif %}{% endfor %}
    ;
run;

proc sql;
    create table cb_total_subject as
    select
{% for variable in class_base %}        {{ variable }}{% if not loop.last %},{% endif %}
{% endfor %}        ,count(distinct case
            when not missing({{ change | sas_name }})
             and not missing({{ subject | sas_name }})
            then {{ subject | sas_name }}
        end) as SUBJECT_N
    from cb_source
    group by {{ class_base | join(', ') }}
    ;
quit;

proc sql;
    create table cb_total_group as
    select s.*, q.SUBJECT_N
    from cb_total_stat as s
    left join cb_total_subject as q
      on {% for variable in class_base %}(
           s.{{ variable }} = q.{{ variable }}
           or (missing(s.{{ variable }}) and missing(q.{{ variable }}))
         ){% if not loop.last %} and{% endif %}
         {% endfor %}
    ;
quit;
{% endif %}

/* Convert the statistic columns to a compact long intermediate table. */
data cb_long;
    set cb_group;
    length STATISTIC $32 VALUE 8;
{% for stat in statistics %}    STATISTIC = '{{ stat }}'; VALUE = {{ stat }}; output;
{% endfor %}    STATISTIC = 'SUBJECT_N'; VALUE = SUBJECT_N; output;
    keep {{ class_group | join(' ') }} STATISTIC VALUE;
run;
{% if include_total %}data cb_total_long;
    set cb_total_group;
    length _trt_order 8 _trt_label $200 STATISTIC $32 VALUE 8;
    _trt_order = {{ total_order }};
    _trt_label = 'Total';
{% for stat in statistics %}    STATISTIC = '{{ stat }}'; VALUE = {{ stat }}; output;
{% endfor %}    STATISTIC = 'SUBJECT_N'; VALUE = SUBJECT_N; output;
    keep {{ class_base | join(' ') }} _trt_order _trt_label STATISTIC VALUE;
run;
{% endif %}data cb_all_long;
    set cb_long{% if include_total %} cb_total_long{% endif %};
run;

/* Assemble the final horizontal result in the configured column order. */
proc sql;
    create table cb_wide as
    select
        _item_order,
        _item_sort,
        _item_label as ITEM length=200{% for row in rows %},
        {{ row.sas_name }}{% endfor %}{% for row in rows %},
        {{ row.missing_flag }}{% endfor %}{% if treatment_columns %}
{% for level in treatment_levels %}{% for stat in statistics %},
        max(case when _trt_order = {{ level.order }} and STATISTIC = '{{ stat }}' then VALUE end) as TRT_{{ level.order }}_{{ stat }}{% endfor %},
        max(case when _trt_order = {{ level.order }} and STATISTIC = 'SUBJECT_N' then VALUE end) as TRT_{{ level.order }}_SUBJECT_N{% endfor %}{% if include_total %}{% for stat in statistics %},
        max(case when _trt_order = {{ total_order }} and STATISTIC = '{{ stat }}' then VALUE end) as TOTAL_{{ stat }}{% endfor %},
        max(case when _trt_order = {{ total_order }} and STATISTIC = 'SUBJECT_N' then VALUE end) as TOTAL_SUBJECT_N{% endif %}{% else %}{% for stat in statistics %},
        max(case when STATISTIC = '{{ stat }}' then VALUE end) as {{ stat }}{% endfor %},
        max(case when STATISTIC = 'SUBJECT_N' then VALUE end) as SUBJECT_N{% endif %}
    from cb_all_long
    group by _item_order, _item_sort, _item_label{% for row in rows %}, {{ row.sas_name }}{% endfor %}{% for row in rows %}, {{ row.missing_flag }}{% endfor %}
    ;
quit;

proc sort data=cb_wide;
    by {{ row_sort_terms | join(' ') }};
run;

data {{ target_dataset }};
    set cb_wide;
    label ITEM = 'Item'
{% for column in output_columns %}          {{ column.name }} = {{ column.label | sas_string }}
{% endfor %}          ;
{% for column in output_columns %}{% if column.format %}    format {{ column.name }} {{ column.format }};
{% endif %}{% endfor %}    drop _item_order _item_sort
{% for row in rows %}          {{ row.missing_flag }}
{% endfor %}          ;
run;

/* Remove only intermediate WORK tables; the requested result is retained. */
proc datasets library=work nolist;
    delete cb_source cb_stat cb_subject cb_group
{% if include_total %}           cb_total_stat cb_total_subject cb_total_group cb_total_long
{% endif %}           cb_long cb_all_long cb_wide;
quit;
