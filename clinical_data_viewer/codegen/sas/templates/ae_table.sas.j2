/*
  Generated by SASDataViewer
  AE SOC/PT Table
  Reference engine: python_ae_soc_pt_v1
  Hierarchy sorting is recalculated at runtime from total frequency.
*/

options validvarname=any;

/* Prepare AE source */
{% if source.format == "xpt" %}
libname {{ source_library }} xport {{ source.path | sas_string }};
{% else %}
libname {{ source_library }} {{ source.directory | sas_string }};
{% endif %}
{% if population_source %}
{% if population_source.format == "xpt" %}
libname pop xport {{ population_source.path | sas_string }};
{% else %}
libname pop {{ population_source.directory | sas_string }};
{% endif %}
{% endif %}

data ae0;
    set {{ source_library }}.{{ source_member }};
{% if dataset_filter %}    if not ({{ dataset_filter }}) then delete;
{% endif %}    length _trt _trt_key _soc _soc_key _pt _pt_key _subjid $200;
    if missing({{ treatment | sas_name }}) then do;
        put "ERROR: missing treatment values exist.";
        abort cancel;
    end;
    _trt = {{ raw_treatment }};
    _trt_key = lowcase(_trt);
    if missing({{ subject | sas_name }}) then delete;
    _subjid = {{ raw_subject }};
    if missing({{ soc | sas_name }}) then _soc = {{ soc_missing_literal }};
    else _soc = {{ raw_soc }};
    _soc_key = lowcase(_soc);
    if missing({{ pt | sas_name }}) then _pt = {{ pt_missing_literal }};
    else _pt = {{ raw_pt }};
    _pt_key = lowcase(_pt);
run;
{% if population_source %}
/* Prepare population denominator */
data pop0;
    set pop.{{ population_source.dataset }};
{% if population_filter %}    if not ({{ population_filter }}) then delete;
{% endif %}    length _trt _trt_key _subjid $200;
    if missing({{ treatment | sas_name }}) then do;
        put "ERROR: missing treatment values exist in population.";
        abort cancel;
    end;
    _trt = {{ raw_treatment }};
    _trt_key = lowcase(_trt);
    if missing({{ subject | sas_name }}) then delete;
    _subjid = {{ raw_subject }};
run;
{% endif %}

/* Discover treatment levels */
proc sql;
    create table trt as
    select distinct _trt, _trt_key
    from {{ level_source }}
    order by _trt_key, _trt;
quit;

data trt;
    set trt;
    trt_order + 1;
    trt_label = _trt;
run;

proc sql noprint;
    select count(*) into :ntrt trimmed from trt;
    select cats('"', tranwrd(trt_label, '"', '""'), ' n (%)"')
        into :col_label1- from trt order by trt_order;
quit;

/* Calculate denominators (never filtered by SOC/PT) */
proc sql;
    create table denom as
    select
        t.trt_order,
        count(distinct d._subjid) as denom
    from {{ level_source }} as d
    inner join trt as t
        on d._trt = t._trt
    group by t.trt_order;
quit;

proc sql noprint;
    select count(distinct _subjid) into :denom_total trimmed
    from {{ level_source }};
quit;

/* Calculate Any AE */
proc sql;
    create table any_freq as
    select
        t.trt_order,
        count(distinct a._subjid) as freq
    from ae0 as a
    inner join trt as t
        on a._trt = t._trt
    group by t.trt_order;
quit;

proc sql noprint;
    select count(distinct _subjid) into :any_total trimmed
    from ae0;
quit;

/* Calculate SOC frequencies */
proc sql;
    create table soc_freq as
    select
        t.trt_order,
        a._soc as soc,
        a._soc_key as soc_key,
        count(distinct a._subjid) as freq
    from ae0 as a
    inner join trt as t
        on a._trt = t._trt
    where not missing(a._soc)
    group by t.trt_order, a._soc, a._soc_key;
quit;

proc sql;
    create table soc_total as
    select
        a._soc as soc,
        a._soc_key as soc_key,
        count(distinct a._subjid) as freq
    from ae0 as a
    where not missing(a._soc)
    group by a._soc, a._soc_key;
quit;

/* Calculate PT frequencies */
proc sql;
    create table pt_freq as
    select
        t.trt_order,
        a._soc as soc,
        a._soc_key as soc_key,
        a._pt as pt,
        a._pt_key as pt_key,
        count(distinct a._subjid) as freq
    from ae0 as a
    inner join trt as t
        on a._trt = t._trt
    where not missing(a._soc)
      and not missing(a._pt)
    group by t.trt_order, a._soc, a._soc_key, a._pt, a._pt_key;
quit;

proc sql;
    create table pt_total as
    select
        a._soc as soc,
        a._soc_key as soc_key,
        a._pt as pt,
        a._pt_key as pt_key,
        count(distinct a._subjid) as freq
    from ae0 as a
    where not missing(a._soc)
      and not missing(a._pt)
    group by a._soc, a._soc_key, a._pt, a._pt_key;
quit;

/* Apply runtime hierarchy sorting */
proc sort data=soc_total out=soc_order;
    by descending freq soc_key soc;
run;

data soc_order;
    set soc_order;
    soc_ord + 1;
run;

proc sql;
    create table soc_order2 as
    select
        s.*,
        coalesce(p.pt_count, 0) as pt_count
    from soc_order as s
    left join (
        select soc, count(*) as pt_count
        from pt_total
        group by soc
    ) as p
        on s.soc = p.soc
    order by s.soc_ord;
quit;

proc sql;
    create table pt_order as
    select
        p.*,
        s.soc_ord
    from pt_total as p
    inner join soc_order2 as s
        on p.soc = s.soc
    order by s.soc_ord, descending p.freq, p.pt_key, p.pt;
quit;

data pt_order;
    set pt_order;
    by soc_ord;
    if first.soc_ord then pt_ord=0;
    pt_ord + 1;
run;

/* Build hierarchy rows from current runtime frequencies */
proc sql;
    create table items as
{% if include_any %}    select
        1 as row_order,
        'any' as row_type length=4,
        '' as soc length=200,
        '' as pt length=200,
        {{ any_label | sas_string }} as item length=200,
        0 as indent
    from dictionary.tables
    where libname='WORK' and memname='AE0'
    union all
{% endif %}    select
        {{ row_order_offset }} + s.soc_ord
            + coalesce((select sum(x.pt_count)
                       from soc_order2 as x
                       where x.soc_ord < s.soc_ord), 0) as row_order,
        'soc' as row_type length=4,
        s.soc,
        '' as pt,
        s.soc as item,
        0 as indent
    from soc_order2 as s
    union all
    select
        {{ row_order_offset }} + p.soc_ord
            + coalesce((select sum(x.pt_count)
                       from soc_order2 as x
                       where x.soc_ord < p.soc_ord), 0)
            + p.pt_ord as row_order,
        'pt' as row_type length=4,
        p.soc,
        p.pt,
        p.pt as item,
        1 as indent
    from pt_order as p;
quit;

/* Build long result for audit and final transposition */
proc sql;
    create table long0 as
    select
        i.row_order,
        i.row_type,
        i.soc,
        i.pt,
        i.item,
        i.indent,
        t.trt_order,
        t.trt_label,
        coalesce(f.freq, 0) as freq,
        coalesce(d.denom, 0) as denom
    from items as i
    cross join trt as t
    left join denom as d
        on d.trt_order = t.trt_order
    left join (
        select
            'any' as row_type length=4,
            '' as soc length=200,
            '' as pt length=200,
            trt_order,
            freq
        from any_freq
        union all
        select 'soc', soc, '', trt_order, freq
        from soc_freq
        union all
        select 'pt', soc, pt, trt_order, freq
        from pt_freq
    ) as f
        on f.row_type = i.row_type
       and f.soc = i.soc
       and f.pt = i.pt
       and f.trt_order = t.trt_order;
quit;
{% if include_total %}
proc sql;
    create table long_total as
    select
        i.row_order,
        i.row_type,
        i.soc,
        i.pt,
        i.item,
        i.indent,
        &ntrt + 1 as trt_order,
        'Total' as trt_label,
        coalesce(case
            when i.row_type = 'any' then &any_total
            when i.row_type = 'soc' then s.freq
            when i.row_type = 'pt' then p.freq
        end, 0) as freq,
        coalesce(&denom_total, 0) as denom
    from items as i
    left join soc_total as s
        on i.row_type = 'soc' and i.soc = s.soc
    left join pt_total as p
        on i.row_type = 'pt'
       and i.soc = p.soc
       and i.pt = p.pt;
quit;

data long1;
    set long0 long_total;
run;
{% else %}
data long1;
    set long0;
run;
{% endif %}

data long;
    set long1;
    length display $200;
    if denom = 0 then display = '0 (—)';
    else do;
        pct = freq / denom * 100;
        pct = round(pct, {{ percent_increment }});
        display = cats(strip(put(freq, best.-L)), ' (',
                       strip(put(pct, 12.{{ digits }})), ')');
    end;
run;

/* Build final table: item, col1..colN (Total is last when enabled) */
proc sql;
    create table {{ output }} as
    select
        case when i.indent = 0 then strip(i.item)
             else cats(repeat(' ', i.indent * 4 - 1), strip(i.item))
        end as item length=200
%macro ae_columns;
%do _i=1 %to %eval({{ max_column }});
        , max(case when l.trt_order = &_i
                   then l.display else '' end) as col&_i length=200
%end;
%mend;
%ae_columns;
    from (
        select distinct row_order, row_type, soc, pt, item, indent
        from items
    ) as i
    left join long as l
        on l.row_order = i.row_order
    group by i.row_order, i.row_type, i.soc, i.pt, i.item, i.indent
    order by i.row_order;
quit;

/* Add readable treatment labels to dynamic columns */
data {{ output }};
    set {{ output }};
%macro ae_labels;
%do _i=1 %to &ntrt;
    label col&_i = &&col_label&_i;
%end;
{% if include_total %}    label col%eval(&ntrt + 1) = 'Total n (%)';
{% endif %}%mend;
%ae_labels;
run;
