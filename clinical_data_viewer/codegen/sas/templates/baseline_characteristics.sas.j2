/* Baseline Characteristics generated by SASDataViewer.
   The final shell intentionally has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data work.{{ source.work_prefix }}_source;
  set {{ source.library }}.{{ source.member }};
{% if where_expression %}  where {{ where_expression }};
{% endif %}run;

proc sql noprint;
  select count(distinct {{ subject }}) into :n1 trimmed
{% if population_is_source %}  from work.{{ source.work_prefix }}_source{% else %}  from {{ population.library }}.{{ population.member }}{% endif %}{% if population_where_expression %} where {{ population_where_expression }};{% else %};{% endif %}
  select count(*) into :missing_subject trimmed from work.{{ source.work_prefix }}_source where missing({{ subject }});
  select count(*)-count(distinct {{ subject }}) into :duplicate_subject trimmed from work.{{ source.work_prefix }}_source;
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

data {{ long_output }};
  length row_order item_order 8 item_kind $12 variable $32 item_label $256 unit $80
         row_label $320 level_value display_level $400 statistic_key $16
         raw_value_1 raw_value_2 numerator denominator percent 8 row_value $80
         cnt1 cnt2 $32;
  stop;
run;

{% for item in items %}
{% if item.role == "categorical" %}
/* Categorical item: {{ item.label }} */
data work.{{ source.work_prefix }}_cat_source_{{ item.order }};
  length level_value $400 sort_rank 8;
  set work.{{ source.work_prefix }}_source;
{% if not item.include_missing %}  if ^missing({{ item.variable }});
{% if item.storage_type == "numeric" %}  level_value=strip(put({{ item.variable }},best32.));
{% else %}  level_value=strip({{ item.variable }});
{% endif %}{% else %}{% if item.storage_type == "numeric" %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip(put({{ item.variable }},best32.));
{% else %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip({{ item.variable }});
{% endif %}{% endif %}{% if item.level_order == "custom" %}  sort_rank=1000000;
{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }};
{% endfor %}{% else %}  sort_rank=0;
{% endif %}run;

proc sql;
  create table work.{{ source.work_prefix }}_cat_{{ item.order }} as
  select level_value, min(sort_rank) as sort_rank,
         count(distinct {{ subject }}) as numerator,
         &n1 as denominator,
         calculated numerator*100/calculated denominator as percent
  from work.{{ source.work_prefix }}_cat_source_{{ item.order }}
  group by level_value
  order by sort_rank, level_value;
quit;

data work.{{ source.work_prefix }}_item_{{ item.order }};
  length row_order item_order 8 item_kind $12 variable $32 item_label $256 unit $80
         row_label $320 level_value $400 statistic_key $16
         raw_value_1 raw_value_2 numerator denominator percent 8 row_value $80;
  if _n_=1 then do;
    row_order={{ item.order }}*100000; item_order={{ item.order }};
    item_kind="categorical"; variable={{ item.variable | sas_string }};
    item_label={{ item.label | sas_string }};
    row_label=cats(item_label," - n (%)"); row_value=""; output;
  end;
  set work.{{ source.work_prefix }}_cat_{{ item.order }};
  row_order={{ item.order }}*100000+_n_; item_order={{ item.order }};
  item_kind="categorical"; variable={{ item.variable | sas_string }};
  item_label={{ item.label | sas_string }}; display_level=level_value;
{% if item.level_order == "custom" %}{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then display_level={{ level.display | sas_string }};
{% endfor %}{% endif %}  row_label=cats("    ",display_level);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(percent,{{ item.percent_digits | sas_round_increment }}),
                         16.{{ item.percent_digits }}),")");
  output;
run;
{% else %}
/* Continuous item: {{ item.label }} */
proc means data=work.{{ source.work_prefix }}_source noprint vardef=df qntldef=5;
  var {{ item.variable }};
  output out=work.{{ source.work_prefix }}_stat_{{ item.order }}(drop=_type_ _freq_)
    n=n mean=mean std=std median=median q1=q1 q3=q3 min=min max=max;
run;

data work.{{ source.work_prefix }}_item_{{ item.order }};
  length row_order item_order 8 item_kind $12 variable $32 item_label $256 unit $80
         row_label $320 level_value $400 statistic_key $16
         raw_value_1 raw_value_2 numerator denominator percent 8 row_value $80;
  set work.{{ source.work_prefix }}_stat_{{ item.order }};
  item_order={{ item.order }}; item_kind="continuous";
  variable={{ item.variable | sas_string }}; item_label={{ item.label | sas_string }};
  unit={{ item.unit | sas_string }}; denominator=&n1; numerator=n;
  row_order={{ item.order }}*100000; row_label=item_label;
  row_value=""; output;
{% if "n" in item.statistics %}  row_order+1; statistic_key="n"; row_label="    n";
  raw_value_1=n; raw_value_2=.; row_value=strip(put(n,3.)); output;
{% endif %}{% for key, label in (("mean", "Mean"), ("std", "SD"), ("median", "Median")) %}{% if key in item.statistics %}  row_order+1; statistic_key="{{ key }}"; row_label="    {{ label }}";
  raw_value_1={{ key }}; raw_value_2=.;
  row_value=strip(put(round(raw_value_1,{{ item.statistic_decimals[key] | sas_round_increment }}),8.{{ item.statistic_decimals[key] }}));
  if missing(raw_value_1) then row_value="-";
  output;
{% endif %}{% endfor %}{% if "q1" in item.statistics %}  row_order+1; statistic_key="q1_q3"; row_label="    Q1, Q3";
  raw_value_1=q1; raw_value_2=q3;
  cnt1=strip(put(round(q1,{{ item.statistic_decimals.q1 | sas_round_increment }}),8.{{ item.statistic_decimals.q1 }}));
  cnt2=strip(put(round(q3,{{ item.statistic_decimals.q3 | sas_round_increment }}),8.{{ item.statistic_decimals.q3 }}));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
{% endif %}{% if "min" in item.statistics %}  row_order+1; statistic_key="min_max"; row_label="    Min, Max";
  raw_value_1=min; raw_value_2=max;
  cnt1=strip(put(round(min,{{ item.statistic_decimals.min | sas_round_increment }}),8.{{ item.statistic_decimals.min }}));
  cnt2=strip(put(round(max,{{ item.statistic_decimals.max | sas_round_increment }}),8.{{ item.statistic_decimals.max }}));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2); output;
{% endif %}  keep row_order item_order item_kind variable item_label unit row_label level_value
       statistic_key raw_value_1 raw_value_2 numerator denominator percent row_value;
run;
{% endif %}

proc append base={{ long_output }} data=work.{{ source.work_prefix }}_item_{{ item.order }} force; run;
{% endfor %}

proc sort data={{ long_output }};
  by row_order;
run;

data {{ output }}(label={{ header_label | sas_string }});
  set {{ long_output }};
  length value $80;
  value=row_value;
  keep row_label value;
run;

proc datasets library=work nolist;
  delete {{ source.work_prefix }}_source {{ source.work_prefix }}_cat:
         {{ source.work_prefix }}_stat: {{ source.work_prefix }}_item:;
quit;
