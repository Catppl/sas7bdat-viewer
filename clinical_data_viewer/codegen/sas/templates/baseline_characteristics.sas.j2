/* Baseline Characteristics generated by SASDataViewer.
   The final shell intentionally has no footnote. */
options validvarname=any;

/* Prepare analysis source */
data {{ source.work_prefix }}_source;
  set {{ source.reference }};
{% if where_expression %}  where {{ where_expression }};
{% endif %}run;

%let duplicate_subject_ids=;
proc sql noprint;
  select count(distinct {{ subject }}) into :n1 trimmed
{% if population_is_source %}  from {{ source.work_prefix }}_source{% else %}  from {{ population.reference }}{% endif %}{% if population_where_expression %} where {{ population_where_expression }};{% else %};{% endif %}
  select count(*) into :missing_subject trimmed from {{ source.work_prefix }}_source where missing({{ subject }});
  select count(*)-count(distinct {{ subject }}) into :duplicate_subject trimmed from {{ source.work_prefix }}_source;
  select {{ subject }} into :duplicate_subject_ids separated by ', '
  from {{ source.work_prefix }}_source
  where ^missing({{ subject }})
  group by {{ subject }}
  having count(*) > 1
  order by {{ subject }};
quit;

%macro validate_subjects;
  %if &missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    data _null_;
      set {{ source.work_prefix }}_source;
      if missing({{ subject }}) then
        put "ERROR: Missing {{ subject }} at source observation " _n_ ".";
    run;
    %abort cancel;
  %end;
  %if &duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %put ERROR: Duplicate {{ subject }} values: &duplicate_subject_ids.;
    %abort cancel;
  %end;
%mend;
%validate_subjects;

%macro baseline_continuous(
    var=,
    order=,
    label=,
    unit=,
    work_prefix=,
    n_macro=,
    mean_decimals=0,
    std_decimals=0,
    median_decimals=0,
    q1_decimals=0,
    q3_decimals=0,
    min_decimals=0,
    max_decimals=0
);
proc means data=&work_prefix._source noprint vardef=df qntldef=5;
  var &var.;
  output out=&work_prefix._stat_&order.
{% for statistic in continuous_statistics %}    {{ statistic }}={{ statistic }}{% if not loop.last %} {% endif %}{% endfor %};
run;

data &work_prefix._item_&order.;
  length row_order item_order 8 item_kind $200 variable $200 item_label $200 unit $200
         row_label $200 level_value $200 statistic_key $200
         raw_value_1 raw_value_2 numerator denominator percent 8 row_value $200;
  set &work_prefix._stat_&order.;
  if _n_=1 then do;
    item_order=&order.;
    item_kind="continuous";
    variable="&var.";
    item_label=&label.;
    unit=&unit.;
    denominator=&&&n_macro.;
    numerator=n;
    row_order=&order.*1000;
    row_label=item_label;
    row_value="";
    statistic_key="";
    output;

  end;
  item_order=&order.;
  item_kind="continuous";
  variable="&var.";
  item_label=&label.;
  unit=&unit.;
  denominator=&&&n_macro.;
  numerator=n;
{% if "n" in continuous_statistics %}  row_order+1;
  statistic_key="n";
  row_label="    n";
  raw_value_1=n;
  raw_value_2=.;
  row_value=strip(put(n,best.));
  output;

{% endif %}{% if "mean" in continuous_statistics %}  row_order+1;
  statistic_key="mean";
  row_label="    Mean";
  raw_value_1=mean;
  raw_value_2=.;
  row_value=strip(put(raw_value_1,8.&mean_decimals.));
  if missing(raw_value_1) then row_value="-";
  output;

{% endif %}{% if "std" in continuous_statistics %}  row_order+1;
  statistic_key="std";
  row_label="    SD";
  raw_value_1=std;
  raw_value_2=.;
  row_value=strip(put(raw_value_1,8.&std_decimals.));
  if missing(raw_value_1) then row_value="-";
  output;

{% endif %}{% if "median" in continuous_statistics %}  row_order+1;
  statistic_key="median";
  row_label="    Median";
  raw_value_1=median;
  raw_value_2=.;
  row_value=strip(put(raw_value_1,8.&median_decimals.));
  if missing(raw_value_1) then row_value="-";
  output;

{% endif %}{% if "q1" in continuous_statistics %}  row_order+1;
  statistic_key="q1_q3";
  row_label="    Q1, Q3";
  raw_value_1=q1;
  raw_value_2=q3;
  cnt1=strip(put(q1,8.&q1_decimals.));
  cnt2=strip(put(q3,8.&q3_decimals.));
  if missing(q1) then cnt1="-";
  if missing(q3) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2);
  output;

{% endif %}{% if "min" in continuous_statistics %}  row_order+1;
  statistic_key="min_max";
  row_label="    Min, Max";
  raw_value_1=min;
  raw_value_2=max;
  cnt1=strip(put(min,8.&min_decimals.));
  cnt2=strip(put(max,8.&max_decimals.));
  if missing(min) then cnt1="-";
  if missing(max) then cnt2="-";
  row_value=cats(cnt1,", ",cnt2);
  output;

{% endif %}
  keep row_order item_order item_kind variable item_label unit row_label level_value
       statistic_key raw_value_1 raw_value_2 numerator denominator percent row_value;
run;

%mend baseline_continuous;

{% for item in items %}
{% if item.role == "categorical" %}
/* Categorical item: {{ item.label }} */
data {{ source.work_prefix }}_cat_source_{{ item.order }};
  length level_value $200 sort_rank 8;
  set {{ source.work_prefix }}_source;
{% if not item.include_missing %}  if ^missing({{ item.variable }});
{% if item.storage_type == "numeric" %}  level_value=strip(put({{ item.variable }},best32.));
{% else %}  level_value=strip({{ item.variable }});
{% endif %}{% else %}{% if item.storage_type == "numeric" %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip(put({{ item.variable }},best32.));
{% else %}  if missing({{ item.variable }}) then level_value="Missing";
  else level_value=strip({{ item.variable }});
{% endif %}{% endif %}{% if item.level_order == "custom" %}  sort_rank=1000000;
{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }};
{% endfor %}{% else %}  sort_rank=0;
{% endif %}run;

proc sql;
  create table {{ source.work_prefix }}_cat_{{ item.order }} as
  select level_value, min(sort_rank) as sort_rank,
         count(distinct {{ subject }}) as numerator,
         &n1 as denominator,
         calculated numerator*100/calculated denominator as percent
  from {{ source.work_prefix }}_cat_source_{{ item.order }}
  group by level_value
  order by sort_rank, level_value;
quit;

data {{ source.work_prefix }}_item_{{ item.order }};
  length row_order item_order 8 item_kind $200 variable $200 item_label $200 unit $200
         row_label $200 level_value $200 statistic_key $200
         raw_value_1 raw_value_2 numerator denominator percent 8 row_value $200;
  set {{ source.work_prefix }}_cat_{{ item.order }};
  if _n_=1 then do;
    row_order={{ item.order }}*1000;
    item_order={{ item.order }};
    item_kind="categorical";
    variable={{ item.variable | sas_string }};
    item_label={{ item.label | sas_string }};
    row_label=cats(item_label," - n (%)");
    row_value="";
    output;

  end;
  row_order={{ item.order }}*1000+_n_;
  item_order={{ item.order }};
  item_kind="categorical";
  variable={{ item.variable | sas_string }};
  item_label={{ item.label | sas_string }};
  display_level=level_value;
{% if item.level_order == "custom" %}{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then display_level={{ level.display | sas_string }};
{% endfor %}{% endif %}  row_label=cats("    ",display_level);
  row_value=cats(put(numerator,comma16.)," (",
                     put(round(percent,{{ item.percent_digits | sas_round_increment }}),
                         16.{{ item.percent_digits }}),")");
  output;

run;
{% else %}
/* Continuous item: {{ item.label }} */
%baseline_continuous(
    var={{ item.variable }},
    order={{ item.order }},
    label=%str({{ item.label | sas_string }}),
    unit=%str({{ item.unit | sas_string }}),
    work_prefix={{ source.work_prefix }},
    n_macro=n1,
    mean_decimals={{ item.statistic_decimals.mean }},
    std_decimals={{ item.statistic_decimals.std }},
    median_decimals={{ item.statistic_decimals.median }},
    q1_decimals={{ item.statistic_decimals.q1 }},
    q3_decimals={{ item.statistic_decimals.q3 }},
    min_decimals={{ item.statistic_decimals.min }},
    max_decimals={{ item.statistic_decimals.max }}
);
{% endif %}
{% endfor %}

data {{ source.work_prefix }}_long;
  set
{% for item in items %}    {{ source.work_prefix }}_item_{{ item.order }}
{% endfor %}  ;
run;

proc sort data={{ source.work_prefix }}_long;
  by row_order;
run;

data {{ output }};
  set {{ source.work_prefix }}_long;
  length value $200;
  value=row_value;
  keep row_label value;
run;

proc datasets library=work nolist;
  delete {{ source.work_prefix }}_source {{ source.work_prefix }}_cat:
         {{ source.work_prefix }}_stat: {{ source.work_prefix }}_item:;
quit;
