/* Baseline Characteristics generated by SASDataViewer.
   One filtered source row per nonmissing {{ subject }} is required.
   The final shell intentionally has no footnote. */
options validvarname=any;

{% if source.format == "sas7bdat" %}libname {{ source.library }} {{ source.source_directory | sas_string }};
{% else %}libname {{ source.library }} xport {{ source.source_path | sas_string }} access=readonly;
{% endif %}

data work._bc_source;
  set {{ source.library }}.{{ source.member }};
{% if where_expression %}  where {{ where_expression }};
{% endif %}run;

proc sql noprint;
  select count(*) into :_bc_missing_subject trimmed
  from work._bc_source where missing({{ subject }});
  select count(*) - count(distinct {{ subject }}) into :_bc_duplicate_subject trimmed
  from work._bc_source;
  select count(distinct {{ subject }}) into :_bc_header_n trimmed
  from work._bc_source;
quit;

%macro _bc_validate;
  %if &_bc_missing_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics contains missing {{ subject }}.;
    %abort cancel;
  %end;
  %if &_bc_duplicate_subject > 0 %then %do;
    %put ERROR: Baseline Characteristics requires one row per {{ subject }}.;
    %abort cancel;
  %end;
%mend;
%_bc_validate;

data {{ long_output }};
  length row_order item_order 8 item_kind $12 variable $32 item_label $256 unit $80
         row_label $320 level_value display_level $400 statistic_key $16
         raw_value_1 raw_value_2 numerator denominator percent 8 display_value $80;
  stop;
run;

{% for item in items %}
{% if item.role == "categorical" %}
data work._bc_cat_source_{{ item.order }};
  set work._bc_source;
{% if not item.include_missing %}
  where not missing({{ item.variable }});
{% endif %}
  length level_value $400 sort_rank 8;
  level_value=strip(vvalue({{ item.variable }}));
{% if item.level_order == "custom" %}  sort_rank=1000000;
{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then sort_rank={{ level.rank }};
{% endfor %}{% else %}  sort_rank=0;
{% endif %}run;

proc sql;
  create table work._bc_cat_{{ item.order }} as
  select level_value, min(sort_rank) as sort_rank,
         count(distinct {{ subject }}) as numerator,
         &_bc_header_n as denominator,
         calculated numerator * 100 / calculated denominator as percent
  from work._bc_cat_source_{{ item.order }}
  group by level_value
  order by sort_rank, level_value;
quit;

data work._bc_item_{{ item.order }};
  length row_order item_order 8 item_kind $12 variable $32 item_label $256 unit $80
         row_label $320 level_value $400 statistic_key $16
         raw_value_1 raw_value_2 numerator denominator percent 8 display_value $80;
  if _n_=1 then do;
    row_order={{ item.order }}*100000; item_order={{ item.order }};
    item_kind="categorical"; variable={{ item.variable | sas_string }};
    item_label={{ item.label | sas_string }};
    row_label=cats(item_label, " - n (%)"); display_value=""; output;
  end;
  set work._bc_cat_{{ item.order }};
  row_order={{ item.order }}*100000+_n_; item_order={{ item.order }};
  item_kind="categorical"; variable={{ item.variable | sas_string }};
  item_label={{ item.label | sas_string }}; display_level=level_value;
{% if item.level_order == "custom" %}{% for level in item.custom_levels %}  if {{ item.variable }}={{ level.literal }} then display_level={{ level.display | sas_string }};
{% endfor %}{% endif %}  row_label=cats("    ", display_level);
  display_value=cats(put(numerator,comma16.), " (",
                     put(round(percent,10**(-{{ item.percent_digits }})),16.{{ item.percent_digits }}), ")");
  output;
run;
{% else %}
proc means data=work._bc_source noprint vardef=df qntldef=5;
  var {{ item.variable }};
  output out=work._bc_stat_{{ item.order }} n=n mean=mean std=std median=median
         q1=q1 q3=q3 min=min max=max;
run;

/* Maximum observed source precision is not used; decimals are user-specified. */

data work._bc_item_{{ item.order }};
  length row_order item_order 8 item_kind $12 variable $32 item_label $256 unit $80
         row_label $320 level_value $400 statistic_key $16
         raw_value_1 raw_value_2 numerator denominator percent 8 display_value $80;
  set work._bc_stat_{{ item.order }};
  item_order={{ item.order }}; item_kind="continuous";
  variable={{ item.variable | sas_string }}; item_label={{ item.label | sas_string }};
  unit=""; denominator=&_bc_header_n; numerator=n;
  row_order={{ item.order }}*100000; row_label=item_label;
  display_value=""; output;

{% if "n" in item.statistics %}  row_order+1; statistic_key="n"; row_label="    n";
  raw_value_1=n; raw_value_2=.; display_value=strip(put(n,comma16.)); output;
{% endif %}

{% for key, label in (("mean", "Mean"), ("std", "SD"), ("median", "Median")) %}{% if key in item.statistics %}  row_order+1; statistic_key="{{ key }}"; row_label="    {{ label }}";
  raw_value_1={{ key }}; raw_value_2=.;
  _dec={{ item.statistic_decimals[key] }};
  display_value=ifc(missing(raw_value_1),"-",strip(putn(round(raw_value_1,10**(-_dec)),cats("32.",_dec)))); output;

{% endif %}{% endfor %}{% if "q1" in item.statistics %}  row_order+1; statistic_key="q1_q3"; row_label="    Q1, Q3";
  raw_value_1=q1; raw_value_2=q3;
  _dec1={{ item.statistic_decimals.q1 }};
  _dec2={{ item.statistic_decimals.q3 }};
  display_value=cats(ifc(missing(q1),"-",strip(putn(round(q1,10**(-_dec1)),cats("32.",_dec1)))),", ",
                     ifc(missing(q3),"-",strip(putn(round(q3,10**(-_dec2)),cats("32.",_dec2))))); output;

{% endif %}{% if "min" in item.statistics %}  row_order+1; statistic_key="min_max"; row_label="    Min, Max";
  raw_value_1=min; raw_value_2=max;
  _dec1={{ item.statistic_decimals.min }};
  _dec2={{ item.statistic_decimals.max }};
  display_value=cats(ifc(missing(min),"-",strip(putn(round(min,10**(-_dec1)),cats("32.",_dec1)))),", ",
                     ifc(missing(max),"-",strip(putn(round(max,10**(-_dec2)),cats("32.",_dec2))))); output;
{% endif %}  keep row_order item_order item_kind variable item_label unit row_label level_value
       statistic_key raw_value_1 raw_value_2 numerator denominator percent display_value;
run;
{% endif %}

proc append base={{ long_output }} data=work._bc_item_{{ item.order }} force; run;
{% endfor %}

proc sort data={{ long_output }}; by row_order; run;
data {{ output }}(label={{ header_label | sas_string }});
  set {{ long_output }};
  length value $80;
  value=display_value;
  keep row_label value;
run;

proc datasets library=work nolist;
  delete _bc_source _bc_cat_: _bc_cat_source_: _bc_stat_: _bc_dec_: _bc_item_:;
quit;
