/*
   Generated by SASDataViewer
   Record-level Listing
   Source: {{ source_library }}.{{ source_member }}
   Data Filter: {{ data_filter or "(none)" }}
*/

options validvarname=any;

/* 1. Prepare source and optional ADSL merge */
{% if source.format == "xpt" %}
libname {{ source_library }} xport {{ source.source_path | sas_string }};
{% else %}
libname {{ source_library }} {{ source.source_directory | sas_string }};
{% endif %}
{% if adsl %}
{% if adsl.format == "xpt" %}
libname adsl xport {{ adsl.source_path | sas_string }};
{% else %}
libname adsl {{ adsl.source_directory | sas_string }};
{% endif %}
data lst_main;
    set {{ source_library }}.{{ source_member }};
    _listing_row = _n_;
run;

proc sort data=lst_main;
    by {{ by | sas_name }};
run;

data lst_adsl;
    set adsl.{{ adsl.dataset }}(
        keep={{ by | sas_name }}{% for variable in adsl_projection %} {{ variable.source | sas_name }}{% endfor %}
    );
{% for variable in adsl_projection %}{% if variable.source != variable.output %}    rename {{ variable.source | sas_name }} = {{ variable.output | sas_name }};
{% endif %}{% endfor %}run;

proc sort data=lst_adsl;
    by {{ by | sas_name }};
run;

data listing_base;
    merge lst_main(in=in_main) lst_adsl;
    by {{ by | sas_name }};
    if in_main;
run;
{% else %}
data listing_base;
    set {{ source_library }}.{{ source_member }};
    _listing_row = _n_;
run;
{% endif %}

/* 2. Apply data filter and derive columns */
data listing_prep;
    set listing_base;
{% if data_filter %}    if not ({{ data_filter }}) then delete;
{% endif %}
{% for column in columns %}{% if column.kind == "character" %}    length _lst_val{{ column.index }} ${{ column.length }};
{% endif %}{% endfor %}
{% for column in columns %}{% if column.division_missing %}    /* {{ column.output }}: division by zero is returned as missing. */
    if {{ column.division_denominator }} = 0 then _lst_val{{ column.index }} = .;
    else _lst_val{{ column.index }} = {{ column.expression }};
{% elif "catx(" in column.expression.lower() %}    /* {{ column.output }}: CATX omits missing arguments and delimiters. */
    _lst_val{{ column.index }} = {{ column.expression }};
{% else %}    _lst_val{{ column.index }} = {{ column.expression }};
{% endif %}
{% endfor %}run;

/* 3. Sort listing records */
proc sort data=listing_prep out=_lst_sorted;
    by
{% for column in sort_columns %}        {% if column.direction == "desc" %}descending {% endif %}_lst_val{{ column.index }}
{% endfor %}        _listing_row;
run;

/* 4. Build result columns and produce the report */
data {{ output_dataset }};
    set _lst_sorted(
        keep=
{% for column in columns %}            _lst_val{{ column.index }}
{% endfor %}    );
    rename
{% for column in columns %}        _lst_val{{ column.index }} = {{ column.output | sas_name }}
{% endfor %}    ;
{% for column in columns %}{% if column.format %}    format {{ column.output | sas_name }} {{ column.format }};
{% endif %}{% if column.label %}    label {{ column.output | sas_name }} = {{ column.label | sas_string }};
{% endif %}{% endfor %}    keep
{% for column in columns %}        {{ column.output | sas_name }}
{% endfor %}    ;
run;

options linesize={{ line_size }};
proc report data={{ output_dataset }} nowd missing spacing=1;
    column{% for column in report_columns %} {{ column.output | sas_name }}{% endfor %};
{% for column in report_columns %}    define {{ column.output | sas_name }} / {{ column.report_type }}{% if column.report_type in ["order", "group"] %} order=data{% endif %}{% if column.noprint %} noprint{% endif %}{% if column.format %} format={{ column.format }}{% endif %}{% if not column.noprint %} style(column)=[cellwidth={{ column.width_percent }}%]{% endif %} {{ column.label | sas_string }};
{% endfor %}run;

/* 5. Clean up */
proc datasets lib=work nolist;
    delete lst_main lst_adsl listing_base listing_prep _lst_sorted;
quit;
