/*
   Generated by SASDataViewer
   Record-level Listing
   Source: {{ source_library }}.{{ source_member }}
   Data Filter: {{ data_filter or "(none)" }}
*/

options validvarname=any;

/* 1. Prepare source and optional ADSL merge */
{% if source.format == "xpt" %}
libname {{ source_library }} xport {{ source.source_path | sas_string }};
{% else %}
libname {{ source_library }} {{ source.source_directory | sas_string }};
{% endif %}
{% if adsl %}
{% if adsl.format == "xpt" %}
libname adsl xport {{ adsl.source_path | sas_string }};
{% else %}
libname adsl {{ adsl.source_directory | sas_string }};
{% endif %}
data lst_main;
    set {{ source_library }}.{{ source_member }};
    _listing_row = _n_;
run;

proc sort data=lst_main;
    by {{ by | sas_name }};
run;

data lst_adsl;
    set adsl.{{ adsl.dataset }}(
        keep={{ by | sas_name }}{% for variable in adsl_projection %} {{ variable.source | sas_name }}{% endfor %}
    );
    if missing({{ by | sas_name }}) then delete;
{% for variable in adsl_projection %}{% if variable.source != variable.output %}    rename {{ variable.source | sas_name }} = {{ variable.output | sas_name }};
{% endif %}{% endfor %}run;

proc sql noprint;
    select count(*) into :_lst_adsl_dup trimmed
    from (
        select {{ by | sas_name }}
        from lst_adsl
        group by {{ by | sas_name }}
        having count(*) > 1
    );
quit;

data _null_;
    if &_lst_adsl_dup > 0 then do;
        put "ERROR: ADSL is not unique by {{ by }}.";
        abort cancel;
    end;
run;

proc sort data=lst_adsl;
    by {{ by | sas_name }};
run;

data listing_base;
    merge lst_main(in=in_main) lst_adsl;
    by {{ by | sas_name }};
    if in_main;
run;
{% else %}
data listing_base;
    set {{ source_library }}.{{ source_member }};
    _listing_row = _n_;
run;
{% endif %}

/* 2. Apply data filter and derive columns */
data listing_prep;
    set listing_base;
{% if data_filter %}    if not ({{ data_filter }}) then delete;
{% endif %}
{% for column in columns %}{% if column.kind == "character" %}    length _lst_val{{ column.index }} $200;
{% endif %}{% if column.report %}    length _lst_out{{ column.index }} $200;
{% endif %}{% endfor %}
{% for column in columns %}{% if column.division_missing %}    /* {{ column.output }}: division by zero is returned as missing. */
    if {{ column.division_denominator }} = 0 then _lst_val{{ column.index }} = .;
    else _lst_val{{ column.index }} = {{ column.expression }};
{% elif "catx(" in column.expression.lower() %}    /* {{ column.output }}: CATX omits missing arguments and delimiters. */
    _lst_val{{ column.index }} = {{ column.expression }};
{% else %}    _lst_val{{ column.index }} = {{ column.expression }};
{% endif %}
{% if column.report %}    _lst_out{{ column.index }} = {% if column.kind == "character" %}_lst_val{{ column.index }}{% elif column.format %}strip(put(_lst_val{{ column.index }}, {{ column.format }})){% else %}{{ column.char_expression }}{% endif %};
{% endif %}{% endfor %}run;

/* 3. Sort listing records */
proc sort data=listing_prep out=listing_sorted;
    by
{% for column in sort_columns %}        {% if column.direction == "desc" %}descending {% endif %}_lst_val{{ column.index }}
{% endfor %}        _listing_row;
run;

/* 4. Build character result columns and produce the report */
data {{ output_dataset }};
    set listing_sorted(
        keep=
{% for column in columns %}            {% if column.report %}_lst_out{{ column.index }}{% else %}_lst_val{{ column.index }}{% endif %}
{% endfor %}    );
{% for column in columns %}{% if column.report %}    length {{ column.output | sas_name }} $200;
    {{ column.output | sas_name }} = _lst_out{{ column.index }};
{% else %}    {{ column.output | sas_name }} = _lst_val{{ column.index }};
{% if not column.report and column.format %}    format {{ column.output | sas_name }} {{ column.format }};
{% endif %}{% endif %}{% if column.label %}    label {{ column.output | sas_name }} = {{ column.label | sas_string }};
{% endif %}{% endfor %}    keep
{% for column in columns %}        {{ column.output | sas_name }}
{% endfor %}    ;
run;

options linesize={{ line_size }};
proc report data={{ output_dataset }} nowd missing;
    column
{% for column in report_columns %}        {{ column.output | sas_name }}
{% endfor %}    ;
{% for column in report_columns %}    define {{ column.output | sas_name }} /
        {{ column.report_type }}
        width={{ column.width }}
        {{ column.label | sas_string }};
{% endfor %}run;

/* 5. Clean up */
proc datasets lib=work nolist;
    delete lst_main lst_adsl listing_base listing_prep listing_sorted;
quit;
