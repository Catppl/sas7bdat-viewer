{% elif row["keys"][0] not in ["subjects", "n", "nmiss"] %}    else if key1 = {{ row["keys"][0] | sas_string }} and missing(value1) then row_value = "—";
    else if key1 = {{ row["keys"][0] | sas_string }} then row_value = strip(put(value1, 8.&{{ row["keys"][0] }}_decimals.));
{% endif %}{% endfor %}    else row_value = "—";
    keep analysis stat_order row_ord trt_ord key1 key2 row_value;
run;

/* Centralized display labels for this analysis variable */
data labels_&token.;
    length analysis $32 item $200 stat_label $40 key1 key2 $32;
{% for row in statistics %}    analysis = "&token.";
    stat_order = {{ loop.index }};
    item = &label.;
