/* One reusable macro per analysis variable.  Variable-specific settings are
   visible at the invocation lines below, so adding another variable does not
   duplicate the PROC MEANS implementation. */
%macro proc_means_vertical(
    var=,
    token=,
    label=,
    row_base=,
    mean_decimals=,
    std_decimals=,
    stderr_decimals=,
    median_decimals=,
    q1_decimals=,
    q3_decimals=,
    min_decimals=,
    max_decimals=,
    lclm_decimals=,
    uclm_decimals=
);
/* Statistics for &var. */
proc means data={{ source.work_member | sas_name }} noprint{% if group_variables %} nway missing{% endif %}
    vardef=df qntldef=5 alpha={{ alpha }};
{% if group_variables %}    class {% for group in group_variables %}{{ group.sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
{% endif %}    var &var.;
    output out=stat_&token.(drop=_type_ _freq_)
{% if proc_statistics %}{% for key in proc_statistics %}        {{ key }}={{ key }}
{% endfor %}        ;
{% else %}        n=internal_n;
{% endif %}run;

/* Distinct subject count for &var. */
proc sql;
    create table subj_&token. as
    select
{% for group in group_variables %}        {{ group.sas_name }},{% endfor %}
        count(distinct {{ subject | sas_name }}) as subject_n
    from {{ source.work_member | sas_name }}
    where not missing(&var.)
      and not missing({{ subject | sas_name }})
{% if group_variables %}    group by {% for group in group_variables %}{{ group.sas_name }}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %};
quit;

/* Align statistics with runtime group order */
proc sql;
    create table out_&token. as
    select g.trt_ord,
           s.*,
           coalesce(u.subject_n, 0) as subject_n
    from trt as g
    left join stat_&token. as s
{% if group_variables %}        on {% for group in group_variables %}g.{{ group.sas_name }} = s.{{ group.sas_name }}{% if not loop.last %} and {% endif %}{% endfor %}
{% else %}        on 1=1
{% endif %}    left join subj_&token. as u
{% if group_variables %}        on {% for group in group_variables %}g.{{ group.sas_name }} = u.{{ group.sas_name }}{% if not loop.last %} and {% endif %}{% endfor %}
{% else %}        on 1=1
{% endif %}    order by g.trt_ord;
quit;

{% if include_total %}
/* Total statistics for &var. */
proc means data={{ source.work_member | sas_name }} noprint
    vardef=df qntldef=5 alpha={{ alpha }};
    var &var.;
    output out=total_&token.(drop=_type_ _freq_)
{% if proc_statistics %}{% for key in proc_statistics %}        {{ key }}={{ key }}
{% endfor %}        ;
{% else %}        n=internal_n;
{% endif %}run;

proc sql;
    create table total_&token._n as
    select count(distinct {{ subject | sas_name }}) as subject_n
    from {{ source.work_member | sas_name }}
    where not missing({{ subject | sas_name }});
quit;

data total_&token._row;
    merge total_&token. total_&token._n;
{% if static_total_ord %}    trt_ord = {{ static_total_ord }};
{% else %}    trt_ord = &n_trt + 1;
{% endif %}
run;
{% endif %}

/* Put all statistics for this analysis variable into one dataset */
data values_&token.;
    set out_&token.{% if include_total %} total_&token._row{% endif %};
    length analysis $32 key1 key2 $32 value1 value2 8 row_value $200;
    analysis = "&token.";
{% for row in statistics %}    stat_order = {{ loop.index }};
    row_ord = %eval(&row_base. + {{ loop.index }});
    key1 = {{ row["keys"][0] | sas_string }};
{% if row["keys"]|length > 1 %}    key2 = {{ row["keys"][1] | sas_string }};
{% else %}    key2 = "";
{% endif %}{% if row["keys"][0] == "subjects" %}    value1 = subject_n;
{% elif row["keys"][0] == "n" and "n" not in proc_statistics %}    value1 = internal_n;
{% else %}    value1 = {{ row["keys"][0] }};
{% endif %}{% if row["keys"]|length > 1 %}    value2 = {{ row["keys"][1] }};
{% else %}    value2 = .;
{% endif %}    output;
{% endfor %}    keep analysis stat_order row_ord trt_ord subject_n key1 key2 value1 value2;
run;

/* Format this variable using its invocation-level decimal settings. */
