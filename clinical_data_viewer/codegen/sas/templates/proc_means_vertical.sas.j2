options validvarname=any;

/* Prepare source */
{% if source.format == "xpt" %}
libname {{ source.library }} xport {{ source.path | sas_string }};
{% else %}
libname {{ source.library }} {{ source.directory | sas_string }};
{% endif %}
data pm_src;
    set {{ source.library }}.{{ source.member | sas_name }};
{% if source_filter %}    where {{ source_filter }};
{% endif %}run;

{% if population_source.uses_source %}
/* Use the filtered analysis source for Population N */
data pop_src;
    set pm_src;
run;
{% else %}
/* Prepare population source */
{% if population_source.format == "xpt" %}
libname {{ population_source.library }} xport {{ population_source.path | sas_string }};
{% elif population_source.library != source.library %}
libname {{ population_source.library }} {{ population_source.directory | sas_string }};
{% endif %}
data pop_src;
    set {{ population_source.library }}.{{ population_source.member | sas_name }};
{% if population_filter %}    where {{ population_filter }};
{% endif %}run;
{% endif %}

/* Population N */
data pop0;
    set pop_src;
    length trt_key $200;
{% if population_treatment %}
{% if population_treatment_kind == "numeric" %}    trt_key = strip(put({{ population_treatment | sas_name }}, best32.));
{% else %}    trt_key = strip({{ population_treatment | sas_name }});
{% endif %}    if missing({{ population_treatment | sas_name }}) then do;
        putlog "ERROR: Population treatment contains missing values.";
        stop;
    end;
{% else %}    trt_key = "ALL";
{% endif %}    if missing({{ subject | sas_name }}) then delete;
run;

proc sql;
    create table pop_n as
    select trt_key,
           count(distinct {{ subject | sas_name }}) as big_n
    from pop0
    group by trt_key;
quit;

proc sql;
    create table pop_total as
    select count(distinct {{ subject | sas_name }}) as big_n
    from pop0;
quit;

/* Runtime group order and header labels */
{% if group_variables %}
proc sql;
    create table grp0 as
    select distinct
{% for group in group_variables %}        {{ group.sas_name }}{% if not loop.last %},{% endif %}
{% endfor %}    from pm_src;
quit;

data grp;
    set grp0;
    length grp_label $200;
{% for group in group_variables %}    length g{{ group.index }}_key g{{ group.index }}_label $200;
{% if group.kind == "numeric" %}    if missing({{ group.sas_name }}) then do;
        g{{ group.index }}_label = "(Missing)";
        g{{ group.index }}_key = "";
    end;
    else do;
        g{{ group.index }}_label = strip(put({{ group.sas_name }}, best32.));
        g{{ group.index }}_key = g{{ group.index }}_label;
    end;
{% else %}    if missing({{ group.sas_name }}) then g{{ group.index }}_label = "(Missing)";
    else g{{ group.index }}_label = strip({{ group.sas_name }});
    if missing({{ group.sas_name }}) then g{{ group.index }}_key = "";
    else g{{ group.index }}_key = lowcase(strip({{ group.sas_name }}));
{% endif %}{% endfor %}    grp_label = catx(" / "{% for group in group_variables %}, g{{ group.index }}_label{% endfor %});
{% if treatment_group_index %}{% if source_treatment_kind == "numeric" %}    trt_key = strip(put({{ treatment | sas_name }}, best32.));
{% else %}    trt_key = strip({{ treatment | sas_name }});
{% endif %}{% endif %}
run;

proc sort data=grp;
    by {% for group in group_variables %}g{{ group.index }}_key{% if not loop.last %} {% endif %}{% endfor %};
run;

data grp;
    set grp;
    grp_ord = _n_;
run;
{% else %}
data grp;
    length grp_label $200 trt_key $200;
    grp_ord = 1;
    grp_label = "All";
    trt_key = "ALL";
    output;
run;
{% endif %}

proc sql;
    create table grp_n as
    select g.*,
{% if treatment_group_index %}           p.big_n
    from grp as g
    left join pop_n as p
        on g.trt_key = p.trt_key;
{% else %}           p.big_n
    from grp as g, pop_n as p;
{% endif %}quit;

proc sql noprint;
    select coalesce(max(grp_ord), 0) into :n_grp trimmed from grp;
quit;

{% for analysis in analysis %}
{% if analysis.base_decimal is none %}
/* Determine base decimals for {{ analysis.name }} from the current source */
data dec_{{ analysis.token }};
    set pm_src(keep={{ analysis.name | sas_name }});
    if not missing({{ analysis.name | sas_name }});
    base_dec = 0;
    do dec = 0 to 4;
        unit = 10 ** (-dec);
        if abs({{ analysis.name | sas_name }} - round({{ analysis.name | sas_name }}, unit))
           <= max(1E-12, abs({{ analysis.name | sas_name }}) * 1E-12) then do;
            base_dec = dec;
            leave;
        end;
    end;
    keep base_dec;
run;
proc sql noprint;
    select coalesce(max(base_dec), 0) into :base_{{ analysis.token }} trimmed
    from dec_{{ analysis.token }};
quit;
{% else %}%let base_{{ analysis.token }} = {{ analysis.base_decimal }};
{% endif %}

/* Statistics for {{ analysis.name }} */
proc means data=pm_src noprint{% if group_variables %} nway missing{% endif %}
    vardef=df qntldef=5 alpha={{ alpha }};
{% if group_variables %}    class {% for group in group_variables %}{{ group.sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
{% endif %}    var {{ analysis.name | sas_name }};
    output out=stat_{{ analysis.token }}(drop=_type_ _freq_)
{% if proc_statistics %}{% for key in proc_statistics %}        {{ key }}={{ key }}
{% endfor %}        ;
{% else %}        n=internal_n;
{% endif %}run;

/* Distinct subject count for {{ analysis.name }} */
proc sql;
    create table subj_{{ analysis.token }} as
    select
{% for group in group_variables %}        {{ group.sas_name }},{% endfor %}
        count(distinct {{ subject | sas_name }}) as subject_n
    from pm_src
    where not missing({{ analysis.name | sas_name }})
      and not missing({{ subject | sas_name }})
{% if group_variables %}    group by {% for group in group_variables %}{{ group.sas_name }}{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %};
quit;

/* Align statistics with runtime group order */
proc sql;
    create table out_{{ analysis.token }} as
    select g.grp_ord,
           g.grp_label,
           g.big_n,
           s.*,
           coalesce(u.subject_n, 0) as subject_n
    from grp_n as g
    left join stat_{{ analysis.token }} as s
{% if group_variables %}        on {% for group in group_variables %}g.{{ group.sas_name }} = s.{{ group.sas_name }}{% if not loop.last %} and {% endif %}{% endfor %}
{% else %}        on 1=1
{% endif %}    left join subj_{{ analysis.token }} as u
{% if group_variables %}        on {% for group in group_variables %}g.{{ group.sas_name }} = u.{{ group.sas_name }}{% if not loop.last %} and {% endif %}{% endfor %}
{% else %}        on 1=1
{% endif %}    order by g.grp_ord;
quit;

{% if include_total %}
/* Total statistics for {{ analysis.name }} */
proc means data=pm_src noprint
    vardef=df qntldef=5 alpha={{ alpha }};
    var {{ analysis.name | sas_name }};
    output out=total_{{ analysis.token }}(drop=_type_ _freq_)
{% if proc_statistics %}{% for key in proc_statistics %}        {{ key }}={{ key }}
{% endfor %}        ;
{% else %}        n=internal_n;
{% endif %}run;

proc sql;
    create table total_{{ analysis.token }}_n as
    select count(distinct {{ subject | sas_name }}) as subject_n
    from pm_src
    where not missing({{ subject | sas_name }});
quit;

data total_{{ analysis.token }}_row;
    merge total_{{ analysis.token }} total_{{ analysis.token }}_n pop_total;
    length grp_label $200;
    grp_ord = &n_grp + 1;
    grp_label = "Total";
run;
{% endif %}

/* Put all statistics for this analysis variable into one dataset */
data values_{{ analysis.token }};
    set out_{{ analysis.token }}{% if include_total %} total_{{ analysis.token }}_row{% endif %};
    length analysis $32 key1 key2 $32 value1 value2 8;
    analysis = {{ analysis.token | sas_string }};
{% for row in statistics %}    stat_order = {{ loop.index }};
    row_ord = {{ (analysis.index - 1) * (statistics|length) + loop.index }};
    key1 = {{ row["keys"][0] | sas_string }};
{% if row["keys"]|length > 1 %}    key2 = {{ row["keys"][1] | sas_string }};
{% else %}    key2 = "";
{% endif %}{% if row["keys"][0] == "subjects" %}    value1 = subject_n;
{% elif row["keys"][0] == "n" and "n" not in proc_statistics %}    value1 = internal_n;
{% else %}    value1 = {{ row["keys"][0] }};
{% endif %}{% if row["keys"]|length > 1 %}    value2 = {{ row["keys"][1] }};
{% else %}    value2 = .;
{% endif %}    output;
{% endfor %}    keep analysis stat_order row_ord grp_ord grp_label big_n subject_n key1 key2 value1 value2;
run;
{% endfor %}

/* Centralized display labels for all analysis variables and statistics */
data pm_labels;
    length analysis $32 item $200 stat_label $40 key1 key2 $32;
{% for analysis in analysis %}{% for row in statistics %}    analysis = {{ analysis.token | sas_string }};
    stat_order = {{ loop.index }};
    item = {{ analysis.label | sas_string }};
    stat_label = {{ row.label | sas_string }};
    key1 = {{ row["keys"][0] | sas_string }};
{% if row["keys"]|length > 1 %}    key2 = {{ row["keys"][1] | sas_string }};
{% else %}    key2 = "";
{% endif %}    output;
{% endfor %}{% endfor %}    keep analysis stat_order item stat_label key1 key2;
run;

/* Centralized decimal rules for all analysis variables and statistics */
data pm_decimals;
    length analysis $32 stat_key $32 base_dec add_dec display_dec 8;
{% for analysis in analysis %}{% for row in statistics %}{% for key in row["keys"] %}    analysis = {{ analysis.token | sas_string }};
    stat_key = {{ key | sas_string }};
    base_dec = &base_{{ analysis.token }};
    add_dec = {{ offsets.get(key, 0) }};
    display_dec = min(4, base_dec + add_dec);
    output;
{% endfor %}{% endfor %}{% endfor %}    keep analysis stat_key base_dec add_dec display_dec;
run;

data pm_values;
    set
{% for analysis in analysis %}        values_{{ analysis.token }}
{% endfor %};
run;

proc sql;
    create table pm_display as
    select v.*, l.item, l.stat_label,
           d1.display_dec as dec1,
           d2.display_dec as dec2
    from pm_values as v
    left join pm_labels as l
        on v.analysis = l.analysis
       and v.stat_order = l.stat_order
    left join pm_decimals as d1
        on v.analysis = d1.analysis
       and v.key1 = d1.stat_key
    left join pm_decimals as d2
        on v.analysis = d2.analysis
       and v.key2 = d2.stat_key;
quit;

/* Format every statistic in one display step */
data pm_long;
    length stat display $200;
    set pm_display;
    stat = stat_label;
    if key2 = "" then do;
        if key1 in ("subjects", "n", "nmiss") then
            display = strip(put(value1, 12.));
        else if missing(value1) then
            display = "—";
        else
            display = strip(putn(value1, cats("32.", dec1)));
    end;
    else if missing(value1) and missing(value2) then
        display = "—, —";
    else
        display = catx(", ",
            ifc(missing(value1), "—", strip(putn(value1, cats("32.", dec1)))),
            ifc(missing(value2), "—", strip(putn(value2, cats("32.", dec2)))));
    keep row_ord item stat grp_ord display;
run;

proc sort data=pm_long;
    by row_ord grp_ord;
run;

proc transpose data=pm_long out={{ output_dataset }}(drop=_name_ row_ord) prefix=col;
    by row_ord item stat;
    id grp_ord;
    var display;
run;

/* Apply readable group labels to the generated columns */
proc sql noprint;
    select cats("col", grp_ord, "=", quote(trim(grp_label) ||
           case when missing(big_n) then "" else cats(" (N=", put(big_n, comma12.), ")") end))
        into :col_labels separated by " "
    from grp_n
    order by grp_ord;
{% if include_total %}    select cats("col", &n_grp + 1, "=", quote(cats("Total (N=", put(big_n, comma12.), ")")))
        into :total_label trimmed
    from pop_total;
{% endif %}
quit;

proc datasets library={{ output_library }} nolist;
    modify {{ output_member }};
    label item = "Item" stat = "Statistic" &col_labels{% if include_total %} &total_label{% endif %};
quit;

/* Clean up intermediate WORK tables */
proc datasets library=work nolist;
    delete pm_src pop_src pop0 pop_n pop_total grp0 grp grp_n pm_labels pm_decimals pm_values pm_display pm_long
{% for analysis in analysis %}        stat_{{ analysis.token }} subj_{{ analysis.token }} out_{{ analysis.token }} values_{{ analysis.token }} dec_{{ analysis.token }}
{% if include_total %}        total_{{ analysis.token }} total_{{ analysis.token }}_n total_{{ analysis.token }}_row
{% endif %}{% endfor %};
quit;

libname {{ source.library }} clear;
{% if population_source.library != source.library %}libname {{ population_source.library }} clear;
{% endif %}
