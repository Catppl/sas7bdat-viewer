{% for row in statistics %}{% if row["keys"]|length > 1 %}    else if key1 = {{ row["keys"][0] | sas_string }} and key2 = {{ row["keys"][1] | sas_string }} and missing(value1) and missing(value2) then row_value = "—, —";
