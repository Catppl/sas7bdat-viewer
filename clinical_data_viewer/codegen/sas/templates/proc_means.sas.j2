/*
   Generated by SASDataViewer - PROC MEANS configuration v{{ version }}
   Reference engine: python_proc_means_v1
   Statistics are recalculated from the source data at run time.
*/

options validvarname=any;

/* Prepare source data */
{% if sas_input_format == "xpt" %}
libname {{ sas_source_library }} xport {{ sas_source_path | sas_string }};
{% else %}
libname {{ sas_source_library }} {{ sas_source_directory | sas_string }};
{% endif %}

data work.{{ work_source }};
    set {{ sas_source_library }}.{{ sas_source_member | sas_name }};
{% if filter_text %}
    where {{ filter_text }};
{% endif %}
run;

{% if by_variables %}
proc sort data=work.{{ work_source }};
    by {% for variable in by_variables %}{{ variable | sas_name }}{% if not loop.last %} {% endif %}{% endfor %};
run;
{% endif %}

/* Calculate statistics, subject counts, and the long result */
{% include "long_result.sas.j2" %}

{% include "runtime_decimals.sas.j2" %}

/* Clean up intermediate WORK tables */
proc datasets library=work nolist;
    delete
        {{ work_source }}
{% for item in analysis %}        {{ item.work_stats }} {{ item.work_long }}{% if include_subject_n and options.subject_id_variable %} {{ item.work_subjects }}{% endif %}{% if decimal_statistics %} {{ item.work_decimals }}{% endif %}
{% endfor %}{% if decimal_statistics %}        {{ work_decimal_values }} {{ work_decimal_rules }}
{% endif %}    ;
quit;

libname {{ sas_source_library }} clear;
